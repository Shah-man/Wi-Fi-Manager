            esc)  return ;;
            enter) scan_attack_menu "$sel" ;;
            num:*) if [ "$num" -ge 1 ] && [ "$num" -le "$n" ]; then sel=$((num-1)); scan_attack_menu "$sel"; fi ;;
        esac
    done
