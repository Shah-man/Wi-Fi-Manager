#!/bin/bash
# wh-master: один файл — много команд (wh/цр, installwh, uninstallwh, wifistart, wifistop)
set -u
set -m
# Глобальная страховка: Ctrl+C НИГДЕ не роняет скрипт. Отдельные функции
# (read_key/prompt_input) ловят его локально и трактуют как Esc/отмену.
# Здесь — общий предохранитель на случай мест, не покрытых локально.
trap ':' INT
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; MAGENTA='\033[0;35m'; CYAN='\033[0;36m'
WHITE='\033[1;37m'; BOLD='\033[1m'; NC='\033[0m'; BG_SEL='\033[7m'
info(){ echo -e "${GREEN}[*]${NC} $1"; }
warn(){ echo -e "${YELLOW}[!]${NC} $1"; }
err(){ echo -e "${RED}[X]${NC} $1"; }
LANG_FILE=/root/.wh_lang
LANG_UI=$(cat "$LANG_FILE" 2>/dev/null || echo ru)
if [ "$EUID" -ne 0 ]; then exec sudo "$0" "$@"; fi
SELF=$(readlink -f "$0")
if [ -n "${SUDO_USER:-}" ]; then USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6); else USER_HOME="$HOME"; fi
[ -z "$USER_HOME" ] && USER_HOME="$HOME"

MON=""; TARGET_BSSID=""; TARGET_CHANNEL=""; SELECTED_IDX=0
HCX_TARGET=""; RUN_LOG=""
WIFI_DIR="$USER_HOME/wifi-tools"
DATA_DIR="$USER_HOME/wifi-unlock"
HACK_LOG="$DATA_DIR/wifi-saved.log"
mkdir -p "$WIFI_DIR" "$DATA_DIR" 2>/dev/null
# файлы создаются под sudo (root) — возвращаем владельца пользователю
fix_owner(){
    [ -n "${SUDO_USER:-}" ] && chown "$SUDO_USER":"$(id -gn "$SUDO_USER" 2>/dev/null)" "$@" 2>/dev/null
}
fix_owner "$WIFI_DIR" "$DATA_DIR"

# ── Подпапки по инструментам (чтобы не сваливать всё в кучу) ──────────
# Логи скана и сохранённых сетей остаются в корне $DATA_DIR (их не трогаем).
PMKID_DIR="$DATA_DIR/pmkid"
HS_DIR="$DATA_DIR/handshake"
PIXIE_DIR="$DATA_DIR/pixie"
REAVER_DIR="$DATA_DIR/reaver"
BULLY_DIR="$DATA_DIR/bully"
WPASEC_DIR="$DATA_DIR/wpasec"
mkdir -p "$PMKID_DIR" "$HS_DIR" "$PIXIE_DIR" "$REAVER_DIR" "$BULLY_DIR" "$WPASEC_DIR" 2>/dev/null
fix_owner "$PMKID_DIR" "$HS_DIR" "$PIXIE_DIR" "$REAVER_DIR" "$BULLY_DIR" "$WPASEC_DIR"

# Чистка ESSID для имени файла: транслит кириллицы, пробелы/спецсимволы → _, пустой → BSSID.
# $1=essid  $2=bssid(опц.)  → печатает безопасный ярлык
translit_ru() {
    # ГОСТ-подобный транслит; sed по буквам (регистр сохраняем)
    printf '%s' "$1" | sed -e '
      s/а/a/g; s/б/b/g; s/в/v/g; s/г/g/g; s/д/d/g; s/е/e/g; s/ё/e/g;
      s/ж/zh/g; s/з/z/g; s/и/i/g; s/й/y/g; s/к/k/g; s/л/l/g; s/м/m/g;
      s/н/n/g; s/о/o/g; s/п/p/g; s/р/r/g; s/с/s/g; s/т/t/g; s/у/u/g;
      s/ф/f/g; s/х/kh/g; s/ц/ts/g; s/ч/ch/g; s/ш/sh/g; s/щ/shch/g;
      s/ъ//g; s/ы/y/g; s/ь//g; s/э/e/g; s/ю/yu/g; s/я/ya/g;
      s/А/A/g; s/Б/B/g; s/В/V/g; s/Г/G/g; s/Д/D/g; s/Е/E/g; s/Ё/E/g;
      s/Ж/Zh/g; s/З/Z/g; s/И/I/g; s/Й/Y/g; s/К/K/g; s/Л/L/g; s/М/M/g;
      s/Н/N/g; s/О/O/g; s/П/P/g; s/Р/R/g; s/С/S/g; s/Т/T/g; s/У/U/g;
      s/Ф/F/g; s/Х/Kh/g; s/Ц/Ts/g; s/Ч/Ch/g; s/Ш/Sh/g; s/Щ/Shch/g;
      s/Ъ//g; s/Ы/Y/g; s/Ь//g; s/Э/E/g; s/Ю/Yu/g; s/Я/Ya/g;'
}
sanitize_tag() {
    local essid="$1" bssid="${2:-}" out
    out=$(translit_ru "$essid")
    out=$(printf '%s' "$out" | tr -c 'A-Za-z0-9._-' '_' | sed 's/__*/_/g; s/^_//; s/_$//')
    if [ -z "$out" ] || [ "$out" = "_" ]; then
        out=$(printf '%s' "$bssid" | tr -c 'A-Za-z0-9' '-')
    fi
    [ -z "$out" ] && out="unknown"
    printf '%s' "$out"
}
# Единая метка времени для имён: ГГГГММДД_ЧЧММ (без секунд)
stamp_now() { date '+%Y%m%d_%H%M'; }

# ── wifistart (встроенный) ────────────────────────────────────────────
# Достаёт читаемое название адаптера (модель) + тип (USB/встроенный)
adapter_info(){
    local iface="$1" devpath busid name type
    devpath=$(readlink -f "/sys/class/net/$iface/device" 2>/dev/null)
    if echo "$devpath" | grep -q '/usb'; then
        type="$(t adapter_usb)"
        # название из /sys/.../product или через lsusb по vendor:product
        name=$(cat "$devpath/../product" 2>/dev/null || cat "$devpath/product" 2>/dev/null)
        if [ -z "$name" ]; then
            local vid pid
            vid=$(cat "$devpath/../idVendor" 2>/dev/null || cat "$devpath/idVendor" 2>/dev/null)
            pid=$(cat "$devpath/../idProduct" 2>/dev/null || cat "$devpath/idProduct" 2>/dev/null)
            [ -n "$vid" ] && [ -n "$pid" ] && name=$(lsusb 2>/dev/null | grep -i "$vid:$pid" | sed 's/.*ID [0-9a-f:]* //I' | head -1)
        fi
    else
        type="$(t adapter_pci)"
        busid=$(basename "$devpath" 2>/dev/null)
        name=$(lspci 2>/dev/null | grep -i "${busid#0000:}" | sed 's/^[0-9a-f:.]* //I' | head -1)
    fi
    [ -z "$name" ] && name="Wi-Fi"
    echo "$name|$type"
}

# Собирает все Wi-Fi интерфейсы с поддержкой monitor mode
list_wifi_ifaces(){
    local iface phy
    for iface in /sys/class/net/*/; do
        iface=$(basename "$iface")
        [ "$iface" = "lo" ] && continue
        [ -e "/sys/class/net/$iface/phy80211" ] || continue
        phy=$(cat "/sys/class/net/$iface/phy80211/name" 2>/dev/null)
        [ -z "$phy" ] && continue
        # адаптер должен уметь monitor mode
        iw phy "$phy" info 2>/dev/null | grep -qi 'monitor' && echo "$iface"
    done
}

# Выбор адаптера: один — сразу; несколько — список; ноль — ошибка.
# Результат в переменную PICKED_IFACE.
pick_wifi_iface(){
    PICKED_IFACE=""
    local ifaces=() i
    while IFS= read -r i; do [ -n "$i" ] && ifaces+=("$i"); done < <(list_wifi_ifaces)
    if [ "${#ifaces[@]}" -eq 0 ]; then
        err "$(t no_adapter)"; return 1
    fi
    if [ "${#ifaces[@]}" -eq 1 ]; then
        PICKED_IFACE="${ifaces[0]}"; return 0
    fi
    # несколько — рисуем меню выбора
    local sel=0 n="${#ifaces[@]}"
    while true; do
        clear
        echo -e "${CYAN}${BOLD}  $(t pick_adapter)${NC}\n"
        local idx
        for idx in "${!ifaces[@]}"; do
            local ifc="${ifaces[idx]}" info drv nm tp
            info=$(adapter_info "$ifc"); nm="${info%|*}"; tp="${info#*|}"
            drv=$(basename "$(readlink -f "/sys/class/net/$ifc/device/driver" 2>/dev/null)" 2>/dev/null)
            local line
            line=$(printf "%-8s %-22s (%s, %s)" "$ifc" "$nm" "$drv" "$tp")
            if [ "$idx" -eq "$sel" ]; then echo -e "${BG_SEL} $((idx+1)) $line ${NC}"
            else echo -e "  ${WHITE}$((idx+1)) $line${NC}"; fi
        done
        echo -e "\n${CYAN}$(t pick_hint)${NC}"
        local key; key=$(read_key); local num="${key#num:}"
        case "$key" in
            up)   ((sel>0)) && ((sel--)) ;;
            down) ((sel<n-1)) && ((sel++)) ;;
            esc)  return 1 ;;
            enter) PICKED_IFACE="${ifaces[sel]}"; return 0 ;;
            num:*) if [ "$num" -ge 1 ] && [ "$num" -le "$n" ]; then PICKED_IFACE="${ifaces[num-1]}"; return 0; fi ;;
        esac
    done
}

wifistart_main() {
    local IFACE MONI OUT
    # выбор адаптера (список, если несколько; сразу — если один)
    pick_wifi_iface || return 1
    IFACE="$PICKED_IFACE"
    # монитор уже поднят на этом адаптере?
    if iw dev "$IFACE" info 2>/dev/null | grep -q "type monitor"; then
        MONI="$IFACE"
        info "$(L "Мониторный режим уже активен на $MONI — использую его." "Monitor mode already active on $MONI — using it.")"
    else
        info "$(L "Найден адаптер: $IFACE" "Adapter found: $IFACE")"
        info "$(L "Убиваю мешающие процессы..." "Killing interfering processes...")"
        airmon-ng check kill >/dev/null 2>&1
        systemctl stop avahi-daemon.socket avahi-daemon.service >/dev/null 2>&1 || true

        info "$(L "Поднимаю мониторный режим на $IFACE..." "Enabling monitor mode on $IFACE...")"
        OUT=$(airmon-ng start "$IFACE" 2>&1)
        MONI=$(echo "$OUT" | grep -oP 'on \[[^]]+\]\K\S+' | head -1)
        [ -z "$MONI" ] && MONI=$(iw dev 2>/dev/null | grep -oP 'Interface \K\S*mon\S*' | head -1)
        # если airmon не переименовал — интерфейс мог остаться прежним в monitor
        [ -z "$MONI" ] && iw dev "$IFACE" info 2>/dev/null | grep -q "type monitor" && MONI="$IFACE"

        [ -z "$MONI" ] && { err "$(L "Не удалось поднять монитор" "Failed to enable monitor")"; return 1; }
        ip link set "$MONI" up 2>/dev/null
        local tries=0
        while [ $tries -lt 3 ]; do
            sleep 1
            if iw dev "$MONI" info 2>/dev/null | grep -q "type monitor"; then break; fi
            tries=$((tries+1))
        done
        iw dev "$MONI" info 2>/dev/null | grep -q "type monitor" || { err "$(L "$MONI не в monitor" "$MONI not in monitor mode")"; return 1; }
    fi

    echo "$MONI" > /tmp/.wifistart_mon
    info "$(L "Мониторный режим готов на $MONI" "Monitor mode ready on $MONI")"
}

wifistop_main() {
    local MONI=""
    [ -f /tmp/.wifistart_mon ] && MONI=$(cat /tmp/.wifistart_mon 2>/dev/null)
    if [ -z "$MONI" ] || ! iw dev 2>/dev/null | grep -q "Interface $MONI"; then
        MONI=$(iw dev 2>/dev/null | grep -oP 'Interface \K\S*mon\S*' | head -1)
    fi
    if [ -n "$MONI" ]; then info "$(L "Выключаю $MONI..." "Disabling $MONI...")"; airmon-ng stop "$MONI" >/dev/null 2>&1
    else warn "$(L "Монитор не найден — возможно, уже выключен" "Monitor not found — probably already off")"; fi
    rm -f /tmp/.wifistart_mon
    info "$(L "Поднимаю сетевые сервисы..." "Restoring network services...")"
    systemctl start avahi-daemon.socket avahi-daemon.service >/dev/null 2>&1 || true
    systemctl start wpa_supplicant >/dev/null 2>&1 || true
    systemctl list-unit-files 2>/dev/null | grep -q '^NetworkManager\.service' && systemctl start NetworkManager >/dev/null 2>&1 || true
    info "$(L "Система возвращена в нормальный режим" "System restored to normal mode")"
}

# ── installwh (встроенный) ────────────────────────────────────────────
ROOT=/opt/wifi-tools; SRC="$ROOT/src"; mkdir -p "$SRC"
WH_REPO=""
NAMES=(aircrack-ng pixiewps reaver bully hcxdumptool hcxtools)
declare -A URL=(
 [aircrack-ng]=https://github.com/aircrack-ng/aircrack-ng
 [pixiewps]=https://github.com/wiire-a/pixiewps
 [reaver]=https://github.com/t6x/reaver-wps-fork-t6x
 [bully]=https://github.com/aanarchyy/bully
 [hcxdumptool]=https://github.com/ZerBea/hcxdumptool
 [hcxtools]=https://github.com/ZerBea/hcxtools
)

ensure_links(){
    local n
    for n in цр installwh uninstallwh wifistart wifistop; do
        ln -sf "$SELF" "/usr/local/bin/$n"
    done
}

detect_pm(){
    if [ -f /etc/altlinux-release ] || grep -qi "ALT" /etc/os-release 2>/dev/null; then
        PM=alt; DISTRO="ALT Linux"
    elif command -v dnf >/dev/null 2>&1; then PM=dnf; DISTRO="Fedora/RHEL"
    elif command -v apt-get >/dev/null 2>&1; then PM=apt; DISTRO="Debian/Ubuntu"
    elif command -v pacman >/dev/null 2>&1; then PM=pacman; DISTRO="Arch"
    else PM=none; DISTRO="Unknown"; fi
    info "$(L "Система: $DISTRO | Менеджер: $PM" "System: $DISTRO | Manager: $PM")"
}


ensure_deps(){
    detect_pm
    info "$(L "Пакетный менеджер: $PM" "Package manager: $PM")"
    [ "$LANG_UI" = en ] && local PMLC="LC_ALL=C" || local PMLC=""
    case $PM in
    alt) env $PMLC apt-get update >/dev/null 2>&1; env $PMLC apt-get install -y git make gcc gcc-c++ pkg-config libtool_2.4 autoconf automake libnl-devel libpcap-devel zlib-devel libpcre2-devel libsqlite3-devel libssl-devel libcurl-devel usbutils pciutils || true ;;
    apt) env $PMLC apt-get update -y >/dev/null 2>&1; env $PMLC apt-get install -y git make gcc g++ pkg-config libtool autoconf automake libnl-3-dev libnl-genl-3-dev libpcap-dev zlib1g-dev libpcre2-dev libsqlite3-dev libssl-dev libcurl4-openssl-dev usbutils pciutils || true ;;
    dnf) env $PMLC dnf install -y git make gcc gcc-c++ pkgconfig libtool autoconf automake libnl3-devel libpcap-devel zlib-devel pcre2-devel sqlite-devel openssl-devel libcurl-devel usbutils pciutils || true ;;
    pacman) env $PMLC pacman -S --noconfirm git make gcc pkgconf libtool autoconf automake libnl libpcap zlib pcre2 sqlite openssl curl usbutils pciutils || true ;;
    none) warn "$(L "Пакетный менеджер не найден — зависимости ставь вручную" "Package manager not found — install dependencies manually")" ;;
    esac
}

remote_head(){ git ls-remote "$1" HEAD 2>/dev/null | awk '{print $1}'; }
local_head(){ git -C "$1" rev-parse HEAD 2>/dev/null; }
short(){ [ -n "${1:-}" ] && echo "${1:0:7}" || echo "-------"; }
def_branch(){ git -C "$1" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@'; }

bin_of(){
    case $1 in
    aircrack-ng) command -v aircrack-ng 2>/dev/null ;;
    pixiewps) command -v pixiewps 2>/dev/null ;;
    reaver) command -v reaver 2>/dev/null ;;
    bully) command -v bully 2>/dev/null || ls /home/*/bully/src/bully /root/bully/src/bully 2>/dev/null | head -1 ;;
    hcxdumptool) command -v hcxdumptool 2>/dev/null ;;
    hcxtools) command -v hcxpcapngtool 2>/dev/null ;;
    esac
}

confirm(){
    echo -e "${YELLOW}$1${NC}"
    echo -e "${CYAN}$(L "[Enter] да | [Esc] отмена" "[Enter] yes | [Esc] cancel")${NC}"
    local k; IFS= read -rsn1 k
    if [[ $k == $'\e' ]]; then echo -e "${RED}$(L "Отменено." "Cancelled.")${NC}"; return 1; fi
    return 0
}

status_line(){
    local n="$1" b loc rem st
    b=$(bin_of "$n"); loc=$(short "$(local_head "$SRC/$n")"); rem=$(short "$(remote_head "${URL[$n]}")")
    if [ -z "$rem" ]; then st="$(L "нет сети" "no network")"
    elif [ ! -d "$SRC/$n/.git" ]; then st="$(L "не склонирован" "not cloned")"
    elif [ "$loc" = "$rem" ]; then { [ -n "$b" ] && st="$(L "актуально" "up to date")" || st="$(L "нужна сборка" "needs build")"; }
    else st="$(L "ДОСТУПНО ОБНОВЛЕНИЕ" "UPDATE AVAILABLE")"; fi
    printf "%-12s %-8s %-9s %-9s %s\n" "$n" "${b:+$(L да yes)}" "$loc" "$rem" "$st"
}

do_status_one(){
    echo; printf "%-12s %-8s %-9s %-9s %s\n" "$(L ПРОЕКТ PROJECT)" "$(L БИНАРЬ BINARY)" "$(L ЛОКАЛЬНО LOCAL)" "$(L "В РЕПО" REMOTE)" "$(L СТАТУС STATUS)"
    status_line "$1"; echo
}

do_status(){
    echo; printf "%-12s %-8s %-9s %-9s %s\n" "$(L ПРОЕКТ PROJECT)" "$(L БИНАРЬ BINARY)" "$(L ЛОКАЛЬНО LOCAL)" "$(L "В РЕПО" REMOTE)" "$(L СТАТУС STATUS)"
    for n in "${NAMES[@]}"; do status_line "$n"; done
    echo
    if [ -n "$WH_REPO" ]; then echo "$(L "wh: репозиторий = $WH_REPO" "wh: repository = $WH_REPO")"
    else echo "$(L "wh: репозиторий не задан — точечное обновление wh пропускается" "wh: repository not set — targeted wh update skipped")"; fi
    echo
}

build_tool(){
    info "$(L "Сборка: $1" "Building: $1")"
    case $1 in
    aircrack-ng) cd "$SRC/aircrack-ng" && ./autogen.sh --with-experimental && make -j"$(nproc)" && make install && ldconfig ;;
    pixiewps) cd "$SRC/pixiewps" && make && make install ;;
    reaver) cd "$SRC/reaver/src" && ./configure && make -j"$(nproc)" && make install ;;
    bully) cd "$SRC/bully/src" && make && install -m 755 bully /usr/local/bin/bully ;;
    hcxdumptool) cd "$SRC/hcxdumptool" && make -j"$(nproc)" && make install ;;
    hcxtools) cd "$SRC/hcxtools" && make -j"$(nproc)" && make install ;;
    esac
}

clone_fresh(){
    ensure_deps
    info "$(L "Клонирование..." "Cloning...")"
    # hcxdumptool закреплён на 6.2.9 (совместимость с ath9k_htc; 7.x ломает arm)
    if [ "$1" = "hcxdumptool" ]; then
        git clone --depth 1 --branch 6.2.9 "${URL[$1]}" "$SRC/$1" || { err "$(L "ошибка клонирования" "clone error")"; return 1; }
    else
        git clone "${URL[$1]}" "$SRC/$1" || { err "$(L "ошибка клонирования" "clone error")"; return 1; }
    fi
    return 0
}

rebuild_tool(){
    local n="$1"
    echo; info "$(L "=== $n: пересборка из локальных исходников ===" "=== $n: rebuild from local sources ===")"
    if [ ! -d "$SRC/$n" ]; then err "$(L "$n не установлен — пересобирать нечего" "$n not installed — nothing to rebuild")"; return 1; fi
    build_tool "$n"; info "$(L "Готово." "Done.")"; do_status_one "$n"
}

force_one(){
    local n="$1"
    echo; info "$(L "=== $n: ПРИНУДИТЕЛЬНОЕ обновление (чистый клон) ===" "=== $n: FORCED update (clean clone) ===")"
    rm -rf "$SRC/$n"
    clone_fresh "$n" || return 1
    build_tool "$n"; do_status_one "$n"
}

update_one(){
    local n="$1" loc rem br
    echo; info "=== $n ==="
    if [ ! -d "$SRC/$n/.git" ]; then
        confirm "$(L "Проект ещё не установлен. Установить (клон+сборка)?" "Project not installed yet. Install (clone+build)?")" || return 0
        clone_fresh "$n" || return 1
        build_tool "$n"; do_status_one "$n"; return 0
    fi
    loc=$(local_head "$SRC/$n"); rem=$(remote_head "${URL[$n]}")
    if [ -z "$rem" ]; then err "$(L "нет сети — обновление невозможно" "no network — update impossible")"; return 1; fi
    if [ "$loc" != "$rem" ]; then
        confirm "$(L "Доступна новая версия: ${loc:0:7} -> ${rem:0:7}. Обновить?" "New version available: ${loc:0:7} -> ${rem:0:7}. Update?")" || { info "$(L "Оставляю текущую версию." "Keeping current version.")"; return 0; }
    else
        confirm "$(L "Версия актуальна (коммит ${loc:0:7}). Обновить (переустановить)?" "Version is up to date (commit ${loc:0:7}). Update (reinstall)?")" || { info "$(L "Оставляю как есть." "Leaving as is.")"; return 0; }
    fi
    git -C "$SRC/$n" fetch --all -q || true
    br=$(def_branch "$SRC/$n"); [ -z "$br" ] && br=master
    git -C "$SRC/$n" reset --hard "origin/$br" || true
    build_tool "$n"; do_status_one "$n"
}

do_update_all(){
    local n loc rem br
    for n in "${NAMES[@]}"; do
        echo; info "=== $n ==="
        if [ ! -d "$SRC/$n/.git" ]; then
            clone_fresh "$n" || continue; build_tool "$n"; continue
        fi
        loc=$(local_head "$SRC/$n"); rem=$(remote_head "${URL[$n]}")
        if [ -z "$rem" ]; then err "$(L "нет сети — пропуск" "no network — skip")"; continue; fi
        if [ "$loc" != "$rem" ]; then
            info "$(L "Новая версия — обновляю..." "New version — updating...")"
            git -C "$SRC/$n" fetch --all -q || true
            br=$(def_branch "$SRC/$n"); [ -z "$br" ] && br=master
            git -C "$SRC/$n" reset --hard "origin/$br" || true
            build_tool "$n"
        else
            [ -n "$(bin_of "$n")" ] && info "$(L "Версия актуальна, пропускаю" "Up to date, skipping")" || build_tool "$n"
        fi
    done
    echo; info "$(L "Готово. Текущий статус:" "Done. Current status:")"; do_status
}

force_all(){ local n; for n in "${NAMES[@]}"; do force_one "$n"; done; }

update_wh(){
    if [ -z "$WH_REPO" ]; then
        warn "$(L "WH_REPO не задан — обновление wh-скрипта пропущено." "WH_REPO not set — wh script update skipped.")"
        warn "$(L "Когда создашь репозиторий, впиши URL в переменную WH_REPO внутри $SELF" "When you create a repo, put its URL into WH_REPO inside $SELF")"
        return 0
    fi
    info "$(L "Обновляю wh из $WH_REPO ..." "Updating wh from $WH_REPO ...")"
    local tmp; tmp=$(mktemp -d)
    if git clone "$WH_REPO" "$tmp/wh-repo" 2>/dev/null; then
        [ -f "$tmp/wh-repo/wh" ] && install -m 755 "$tmp/wh-repo/wh" /usr/local/bin/wh && info "$(L "wh обновлён" "wh updated")"
    else err "$(L "ошибка клонирования репозитория wh" "wh repo clone error")"; fi
    rm -rf "$tmp"
}

inst_main(){
    ensure_links
    local A1=${1:-all} A2=${2:-} n
    case $A1 in
    --status) do_status ;;
    --force) force_all ;;
    --update-all) do_update_all ;;
    wh) update_wh ;;
    aircrack-ng|pixiewps|reaver|bully)
        case $A2 in
        --rebuild) rebuild_tool "$A1" ;;
        --force) force_one "$A1" ;;
        *) update_one "$A1" ;;
        esac ;;
    all)
        ensure_deps
        for n in "${NAMES[@]}"; do
            echo; info "$(L "=== $n: свежий клон + установка в систему ===" "=== $n: fresh clone + system install ===")"
            rm -rf "$SRC/$n"
            clone_fresh "$n" || continue
            build_tool "$n"
        done
        sync_sources_to_kit\n        echo; info "$(L "Готово. Статус:" "Done. Status:")"; do_status ;;
    *) echo "$(L "Использование:" "Usage:") installwh [--status|--force|--update-all|all|wh|<tool> [--rebuild|--force]]" ;;
    esac
}

# ── uninstallwh (встроенный) ──────────────────────────────────────────
uninst_main(){
    local d SRC lang_choice ULANG
    # Выбор языка (цифра без Enter; фолбэк — английский)
    echo "Выберите язык / Choose language:"
    echo "  [1] Русский"
    echo "  [2] English"
    read -rsn1 lang_choice
    case "$lang_choice" in
        1) ULANG=ru ;;
        *) ULANG=en ;;
    esac
    echo "$ULANG" > /root/.wh_lang
    if [ -n "${SUDO_USER:-}" ]; then USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6); else USER_HOME="$HOME"; fi
    [ -z "$USER_HOME" ] && USER_HOME="$HOME"
    SRC="$USER_HOME/wifi-tools/src"
    [ "$ULANG" = ru ] && echo "Удаляю инструменты..." || echo "Removing tools..."
    for d in "$SRC/aircrack-ng" "$SRC/pixiewps" "$SRC/reaver" "$SRC/hcxdumptool" "$SRC/hcxtools"; do
        if [ -d "$d" ]; then
            case "$d" in
            *reaver) ( cd "$d/src" && make uninstall >/dev/null 2>&1 ) ;;
            *) ( cd "$d" && make uninstall >/dev/null 2>&1 ) ;;
            esac
        fi
    done
    rm -f /usr/local/bin/bully
    rm -rf "$USER_HOME/wifi-tools"
    ldconfig 2>/dev/null
    [ "$ULANG" = ru ] && echo "Удаляю команды..." || echo "Removing commands..."
    for n in цр installwh uninstallwh wifistart wifistop wh; do
        rm -f "/usr/local/bin/$n"
    done
    if [ "$ULANG" = en ]; then
        echo "Done. Program removed."
        echo "Your saved networks and logs are kept in: $USER_HOME/wifi-unlock"
        echo "To reinstall: unpack the archive and run  sudo ./installwh.sh"
    else
        echo "Готово. Программа удалена."
        echo "Сохранённые сети и логи остались в: $USER_HOME/wifi-unlock"
        echo "Для повторной установки: распакуй архив и запусти  sudo ./installwh.sh"
    fi
}

