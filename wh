# Список разделов справки: "функция|заголовок-ключ"
menu_help() {
    local hsel=0
    # массив: имя_функции :: заголовок(RU) :: заголовок(EN) :: ключевые слова
    local secs=(
        "help_sec_intro"
        "help_sec_wifistart"
        "help_sec_scan"
        "help_sec_wps"
        "help_sec_handshake"
        "help_sec_pmkid"
        "help_sec_hash"
        "help_sec_online"
        "help_sec_ethics"
    )
    local titles_ru=("О программе" "Подготовка интерфейса" "Сканирование сетей" "WPS-атаки (Pixie/Reaver/Bully)" "Захват Handshake" "Захват PMKID" "Работа с хэшем (локально)" "Онлайн wpa-sec" "Этика и ответственность")
    local titles_en=("About" "Interface prep" "Network scanning" "WPS attacks (Pixie/Reaver/Bully)" "Handshake capture" "PMKID capture" "Work with hash (local)" "Online wpa-sec" "Ethics and responsibility")
    while true; do
        clear
        echo -e "${CYAN}${BOLD}========================================${NC}"
        echo -e "${CYAN}${BOLD}      $(t help_t)      ${NC}"
        echo -e "${CYAN}${BOLD}========================================${NC}"
        echo -e "${WHITE}$(t help_hint)${NC}\n"
        local i total=${#secs[@]}
        for i in "${!secs[@]}"; do
            local ttl; [ "$LANG_UI" = ru ] && ttl="${titles_ru[i]}" || ttl="${titles_en[i]}"
            if [ "$i" -eq "$hsel" ]; then echo -e "${BG_SEL} $((i+1)) ${ttl} ${NC}"
            else echo -e "${CYAN} $((i+1)) ${ttl}${NC}"; fi
        done
        # пункт поиска и назад
        local n_search=$((total+1)) n_back=$((total+2))
        if [ "$hsel" -eq $((n_search-1)) ]; then echo -e "${BG_SEL} $n_search $(t help_search) ${NC}"
        else echo -e "${YELLOW} $n_search $(t help_search)${NC}"; fi
        if [ "$hsel" -eq $((n_back-1)) ]; then echo -e "${BG_SEL} $n_back $(t back) ${NC}"
        else echo -e "${RED} $n_back $(t back)${NC}"; fi
        echo -e "\n${CYAN}$(t hint)${NC}"
        local key; key=$(read_key); local num="${key#num:}"
        [ "$key" = "enter" ] && num=$((hsel+1))
        case "$key" in
            up)   ((hsel>0)) && ((hsel--)) ;;
            down) ((hsel<n_back-1)) && ((hsel++)) ;;
            esc)  return ;;
            enter|num:*)
                [ "$num" -ge 1 ] && [ "$num" -le "$n_back" ] || continue
                if [ "$num" -eq "$n_back" ]; then return
                elif [ "$num" -eq "$n_search" ]; then
                    help_search_run "${secs[@]}"
                else
                    clear; "${secs[$((num-1))]}"; press_any
                fi ;;
        esac
    done
}

# Поиск по всем разделам справки: спрашивает слово, показывает совпадающие разделы.
help_search_run() {
    local secs=("$@")
    local q; clear
    prompt_input "$(t help_search_q)" q || return
    [ -z "$q" ] && return
    clear
    echo -e "${CYAN}${BOLD}$(t help_search_res) \"$q\"${NC}\n"
    local found=0 s out
    for s in "${secs[@]}"; do
        out=$("$s" 2>/dev/null)
        # ищем без учёта регистра
        if printf '%s' "$out" | grep -qi -- "$q"; then
            found=1
            echo -e "${WHITE}════════════════════════════════════${NC}"
            printf '%s' "$out" | grep -i --color=never -- "$q" | head -6
            echo ""
        fi
    done
    [ "$found" -eq 0 ] && echo -e "${YELLOW}$(t help_search_none)${NC}"
    press_any
}

menu_main() {
    SELECTED_IDX=0
    while true; do
        find_mon_iface >/dev/null 2>&1
        local options=(
            "${GREEN}|$(t m1)"
            "${YELLOW}|$(t m2)"
            "${CYAN}|$(t m7)"
            "${MAGENTA}|$(t m3)"
            "${BLUE}|$(t m4)"
            "${CYAN}|$(t m5)"
            "${GREEN}|$(t help_t)"
            "${WHITE}|$(t settings_t)"
            "${YELLOW}|$(t m9)"
            "${RED}|$(t m_exit)"
        )
        draw_menu "$(t title_main)" "${options[@]}"
        local key=$(read_key); local num="${key#num:}"
        [ "$key" = "enter" ] && num=$((SELECTED_IDX+1))
        case "$key" in
            up) ((SELECTED_IDX>0)) && ((SELECTED_IDX--)) ;;
            down) ((SELECTED_IDX<${#options[@]}-1)) && ((SELECTED_IDX++)) ;;
            none) ;;
            esc) clear; exit 0 ;;
            enter|num:*)
                case "$num" in
                    1) wifistart_main ;;
                    2) with_saved_idx menu_scan ;;
                    3) with_saved_idx menu_history ;;
                    4) with_saved_idx menu_wps ;;
                    5) with_saved_idx menu_wpa ;;
                    6) echo -e "\n${CYAN}$(t pr_cmd)${NC}"
                       local cmd="" char
                       while IFS= read -rsn1 char; do
                           if [[ $char == $'\e' ]]; then local rest; read -rsn2 -t 0.1 rest; [ -z "$rest" ] && break
                           elif [[ $char == "" ]]; then break
                           elif [[ $char == $'\x7f' || $char == $'\x08' ]]; then cmd="${cmd%?}"; echo -ne "\b \b"
                           else cmd+="$char"; echo -n "$char"; fi
                       done
                       echo; [ -n "$cmd" ] && run_cmd "$cmd" ;;
                    7) with_saved_idx menu_help ;;
                    8) with_saved_idx menu_settings ;;
                    9) wifistop_main ;;
                    10) clear; exit 0 ;;
                esac ;;
        esac
    done
}

# ── диспетчер: один файл, разные команды ──────────────────────────────
case "$(basename "$0")" in
    installwh)   inst_main "$@" ;;
    uninstallwh) uninst_main ;;
    wifistart)   wifistart_main "$@" ;;
    wifistop)    wifistop_main ;;
    *)           clear; echo -e "${GREEN}${BOLD}$(t msg_init)${NC}"; sleep 0.5; menu_main ;;
esac
