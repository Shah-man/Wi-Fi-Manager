save_crack() {
    local output="$1" pin psk ssid
    pin=$(echo "$output" | grep -oP "WPS PIN:\s*'\K[^']+" | tail -1)
    [ -z "$pin" ] && pin=$(echo "$output" | grep -oP "Pin is '\K[^']+" | tail -1)
    psk=$(echo "$output" | grep -oP "WPA PSK:\s*'\K[^']+" | tail -1)
    [ -z "$psk" ] && psk=$(echo "$output" | grep -oP "WPA PSK is '\K[^']+" | tail -1)
    ssid=$(echo "$output" | grep -oP "AP SSID:\s*'\K[^']+" | tail -1)
    [ -z "$ssid" ] && ssid="$TARGET_BSSID"
    [ -z "$psk" ] && return 0
    db_upsert "$ssid" "$TARGET_BSSID" "$TARGET_CHANNEL" "$pin" "$psk"
    echo -e "\n${GREEN}${BOLD}══════════════════════════════════════${NC}"
    echo -e "${GREEN}${BOLD}   $(t msg_saved)${NC}"
    echo -e "${GREEN}${BOLD}══════════════════════════════════════${NC}"
    echo -e " ${YELLOW}SSID:${NC} $ssid   ${YELLOW}PSK:${NC} $psk"
    echo -e " ${YELLOW}$(t msg_file)${NC} $HACK_LOG"
    echo -e "${GREEN}${BOLD}══════════════════════════════════════${NC}"
    sleep 3
    return 0
}

# Разбор лога reaver/bully → понятная подсказка что произошло и что делать.
# Только ЧИТАЕТ готовый лог и печатает вывод — ничего не запускает, не трогает захват.
explain_wps_result() {
    local log="$1"
    [ -f "$log" ] || return
    local txt; txt=$(cat "$log" 2>/dev/null)
    [ -z "$txt" ] && return
    echo -e "\n${CYAN}${BOLD}$(t wps_verdict)${NC}"
    echo -e "${WHITE}------------------------------------${NC}"
    # разбор по характерным строкам (порядок важен: от «успех» к «причинам провала»)
    if printf '%s' "$txt" | grep -qiE "WPS PIN:|WPA PSK:|Pin is|PSK is"; then
        echo -e " ${GREEN}${BOLD}$(t wps_ok)${NC}"                       # нашёл ключ
    elif printf '%s' "$txt" | grep -qiE "WPS (setup )?locked|AP (rate|is) locked|WARNING.*locked"; then
        echo -e " ${YELLOW}$(t wps_locked)${NC}"                         # WPS заблокирован
        echo -e " ${WHITE}$(t wps_try_pmkid)${NC}"
    elif printf '%s' "$txt" | grep -qiE "receive timeout|timeout occurred|Failed to associate|No associations"; then
        echo -e " ${YELLOW}$(t wps_weak)${NC}"                           # слабый сигнал/нет связи
    elif printf '%s' "$txt" | grep -qiE "WSC NACK|transaction failed|Failed to recover"; then
        echo -e " ${YELLOW}$(t wps_nack)${NC}"                           # точка отказала
        echo -e " ${WHITE}$(t wps_try_pmkid)${NC}"
    elif printf '%s' "$txt" | grep -qiE "not associated|no beacon|Waiting for beacon"; then
        echo -e " ${YELLOW}$(t wps_nobeacon)${NC}"                       # не поймал сеть
    else
        echo -e " ${WHITE}$(t wps_unknown)${NC}"                         # непонятно — см. лог
    fi
    echo -e "${WHITE}------------------------------------${NC}"
}

run_cmd() {
    echo -e "\n${YELLOW}$(t msg_run) ${WHITE}$*${NC}\n"
    # wh игнорирует Ctrl+C, пока работает команда — прервётся только сама команда, не скрипт
    trap '' INT
    case "$*" in
        *reaver*|*bully*)
            # КАРДИНАЛЬНО: используем `script` — он гоняет команду в настоящем
            # псевдо-терминале (pty), поэтому reaver/bully видят "живой терминал"
            # и выдают статистику в реальном времени НА ЭКРАН, а `script`
            # одновременно пишет всё это в файл (для save_crack). Никакого tee/буфера.
            local tmp keep=""
            if [ -n "${RUN_LOG:-}" ]; then tmp="$RUN_LOG"; keep=1; else tmp=$(mktemp); fi
            if command -v script >/dev/null 2>&1; then
                # script -q -e -c "cmd" file : -q тихо, -e вернуть код команды, pty сохраняет живой вывод
                ( trap - INT; script -q -e -c "$*" "$tmp" )
            else
                # запасной путь без script — прямой вывод (живой), но без лога
                ( trap - INT; eval "$@" ) | tee "$tmp"
            fi
            [ -f "$tmp" ] && save_crack "$(cat "$tmp" 2>/dev/null)"
            [ -f "$tmp" ] && explain_wps_result "$tmp"
            if [ -n "$keep" ]; then
                fix_owner "$tmp" 2>/dev/null
                echo -e "\n${WHITE}$(t msg_file)${NC} $tmp"
            else
                rm -f "$tmp"
            fi ;;
        *)
            ( trap - INT; eval "$@" ) ;;
    esac
    trap ':' INT
    RUN_LOG=""   # сбрасываем, чтобы не протёк на следующий вызов
    echo -e "\n${GREEN}$(t msg_done)${NC}"
    local k; IFS= read -rsn1 k
}

# пауза "нажми клавишу" (Esc/Enter) — короткая подсказка, Ctrl+C не убивает скрипт
press_any(){ echo -e "\n${CYAN}$(t press_hint)${NC}"; local k; trap ':' INT; IFS= read -rsn1 k; trap ':' INT; }

prompt_input() {
    local prompt="$1" var_name="$2" default_val="${3:-}" input="" char
    echo -e "\n${YELLOW}$prompt${NC}"
    [ -n "$default_val" ] && echo -e "${CYAN}$(t pr_enterfor) $default_val)${NC}"
    echo -e "${CYAN}$(t pr_cancel)${NC}"
    # Ctrl+C во время ввода = отмена (как Esc), НЕ убивает скрипт
    local __int=0
    trap '__int=1' INT
    while IFS= read -rsn1 char; do
        [ "$__int" = 1 ] && { trap ':' INT; echo -e "\n${RED}✖ $(t msg_cancel)${NC}"; sleep 1; return 1; }
        if [[ $char == $'\e' ]]; then
            local rest; read -rsn2 -t 0.1 rest
            if [ -z "$rest" ]; then trap ':' INT; echo -e "\n${RED}✖ $(t msg_cancel)${NC}"; sleep 1; return 1; fi
        elif [[ $char == "" ]]; then break
        elif [[ $char == $'\x7f' || $char == $'\x08' ]]; then input="${input%?}"; echo -ne "\b \b"
        else input+="$char"; echo -n "$char"; fi
    done
    trap ':' INT
    echo
    [ -z "$input" ] && [ -n "$default_val" ] && input="$default_val"
    eval "$var_name=\"\$input\""
    return 0
}

migrate_db() {
    [ -f "$HACK_LOG" ] || return 0
    grep -q '^\[' "$HACK_LOG" 2>/dev/null || return 0
    local tmp line ts ssid bssid ch pin psk
    tmp=$(mktemp)
    while IFS= read -r line; do
        if [[ $line == \[* ]]; then
            ts=$(echo "$line" | grep -oP '^\[\K[^\]]+')
            ssid=$(echo "$line" | grep -oP 'SSID: \K[^|]*' | sed 's/ *$//')
            bssid=$(echo "$line" | grep -oP 'BSSID: \K[^|]*' | sed 's/ *$//')
            ch=$(echo "$line" | grep -oP 'Ch: \K[^|]*' | sed 's/ *$//')
            pin=$(echo "$line" | grep -oP 'PIN: \K[^|]*' | sed 's/ *$//')
            psk=$(echo "$line" | grep -oP 'PSK: \K[^|]*' | sed 's/ *$//')
            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$ssid" "$bssid" "$ch" "$pin" "$psk" "$ts" >> "$tmp"
        else
            printf '%s\n' "$line" >> "$tmp"
        fi
    done < "$HACK_LOG"
    mv "$tmp" "$HACK_LOG"
    fix_owner "$HACK_LOG"
}

db_key() { local k="$2"; [ -z "$k" ] && k="$1"; echo "$k"; }

db_upsert() { # ssid bssid ch pin psk ; return 0=new 1=updated
    migrate_db
    local ssid="$1" bssid="$2" ch="$3" pin="$4" psk="$5"
    local ts; ts=$(date '+%Y-%m-%d %H:%M:%S')
    local key; key=$(db_key "$ssid" "$bssid")
    local tmp; tmp=$(mktemp); local existed=0
    local s b c p k d
    if [ -f "$HACK_LOG" ]; then
        while IFS=$'\t' read -r s b c p k d; do
            if [ "$(db_key "$s" "$b")" = "$key" ]; then existed=1; continue; fi
            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$s" "$b" "$c" "$p" "$k" "$d" >> "$tmp"
        done < "$HACK_LOG"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$ssid" "$bssid" "$ch" "$pin" "$psk" "$ts" >> "$tmp"
    mv "$tmp" "$HACK_LOG"
    fix_owner "$HACK_LOG"
    return $existed
}

db_delete() {
    local n="$1" i=0 tmp; tmp=$(mktemp)
    local s b c p k d
    while IFS=$'\t' read -r s b c p k d; do
        i=$((i+1)); [ "$i" -eq "$n" ] && continue
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$s" "$b" "$c" "$p" "$k" "$d" >> "$tmp"
    done < "$HACK_LOG"
    mv "$tmp" "$HACK_LOG"
    fix_owner "$HACK_LOG"
}

db_get() {
    local n="$1" i=0 s b c p k d
    while IFS=$'\t' read -r s b c p k d; do
        i=$((i+1))
        if [ "$i" -eq "$n" ]; then NET_S="$s"; NET_B="$b"; NET_C="$c"; NET_P="$p"; NET_K="$k"; NET_D="$d"; return 0; fi
    done < "$HACK_LOG"
    return 1
}

