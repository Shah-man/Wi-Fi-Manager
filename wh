            else
                printf "${color} %d %-17s %-3s %-4s %-4s %-4s %-10s %s${NC}\n" \
                    "$num" "${SCAN_BSSID[i]}" "${SCAN_CH[i]}" "${SCAN_PWR[i]}" \
                    "${SCAN_WPS[i]}" "${SCAN_LCK[i]}" "${SCAN_VEN[i]}" "${SCAN_ESSID[i]}"
            fi
        done
        echo -e "\n${CYAN}$(t scan_hint)${NC}"
