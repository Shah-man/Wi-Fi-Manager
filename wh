            up) ((SELECTED_IDX>0)) && ((SELECTED_IDX--)) ;;
            down) ((SELECTED_IDX<${#options[@]}-1)) && ((SELECTED_IDX++)) ;;
            none) ;;
            esc) return ;;
            enter|num:*)
                [ "$num" -eq 3 ] && return
