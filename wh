    done
    return 1
}

read_key() {
    local key rest
    # Ctrl+C во время ожидания клавиши = ведёт себя как Esc (возврат),
    # НЕ убивает скрипт. Ловим SIGINT локально и превращаем в esc.
    local __int=0
    trap '__int=1' INT
    if ! IFS= read -rsn1 -t 30 key; then
        trap ':' INT
        [ "$__int" = 1 ] && { echo "esc"; return; }   # прервано Ctrl+C → esc
        echo "none"; return                            # просто таймаут
    fi
    trap ':' INT
    [ "$__int" = 1 ] && { echo "esc"; return; }        # Ctrl+C во время чтения → esc
    if [[ $key == $'\e' ]]; then read -rsn2 -t 0.1 rest; key+="$rest"; fi
    case "$key" in
        $'\e[A') echo "up" ;; $'\e[B') echo "down" ;;
        "") echo "enter" ;; $'\e') echo "esc" ;;
        [1-9]) echo "num:$key" ;; *) echo "other" ;;
    esac
}

