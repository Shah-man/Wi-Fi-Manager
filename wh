find_mon_iface() {
    MON=""
    # 1. Если есть файл-подсказка — проверим, ЖИВ ли этот интерфейс и в monitor ли он
    if [ -f /tmp/.wifistart_mon ]; then
        local m; m=$(cat /tmp/.wifistart_mon 2>/dev/null)
        if [ -n "$m" ] && iw dev "$m" info 2>/dev/null | grep -q "type monitor"; then
            MON="$m"; return 0
        else
            # Интерфейс из файла мёртв — удаляем устаревший файл
            rm -f /tmp/.wifistart_mon
        fi
    fi
    # 2. Фолбэк: ищем любой живой monitor-интерфейс в системе
    local cand
    for cand in $(iw dev 2>/dev/null | awk '/Interface/{print $2}'); do
        if iw dev "$cand" info 2>/dev/null | grep -q "type monitor"; then
            MON="$cand"; echo "$MON" > /tmp/.wifistart_mon; return 0
        fi
    done
    MON=""
    return 1
}

require_mon() {
    find_mon_iface
    [ -n "$MON" ] && return 0
    echo -e "\n${RED}✗ $(t msg_nomon)${NC}"
    echo -e "${CYAN}$(t msg_startw)${NC}"
    local k; IFS= read -rsn1 k
    if [[ $k == $'\e' ]]; then echo -e "${RED}✖ $(t msg_cancel)${NC}"; sleep 1; return 1; fi
    wifistart_main
    find_mon_iface
    [ -n "$MON" ] && return 0
    echo -e "${RED}$(t msg_monfail)${NC}"; sleep 2; return 1
}

get_bully() {
    command -v bully 2>/dev/null && return 0
    local p
    for p in /root/bully/src/bully /home/*/bully/src/bully; do
