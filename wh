    while true; do
        local options=(
            "${YELLOW}|$(t s1)"
            "${YELLOW}|$(t s2)"
            "${RED}|$(t back)"
        )
        draw_menu "$(t scan_t)" "${options[@]}"
        local key=$(read_key); local num="${key#num:}"
        [ "$key" = "enter" ] && num=$((SELECTED_IDX+1))
