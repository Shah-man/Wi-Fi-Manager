    _hp "$(L "Два режима: «весь эфир» (ловит PMKID всех сетей вокруг) и «по выбранной сети» (только цель). Стоп — любой клавишей." "Two modes: 'whole air' (captures PMKID of all nearby networks) and 'selected network' (target only). Stop with any key.")"
    _hp "$(L "Ручные команды:" "Manual commands:")"
    _hc "sudo hcxdumptool -i wlan0mon -o pmkid.pcapng --enable_status=31"
    _hc "sudo hcxdumptool -i wlan0mon -o pmkid.pcapng --filterlist_ap=AABBCCDDEEFF --filtermode=2"
    _hp "$(L "Конвертация в хэш для взлома:" "Convert to a crackable hash:")"
    _hc "hcxpcapngtool -o hash.22000 pmkid.pcapng"
