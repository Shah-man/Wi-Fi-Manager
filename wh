# ── WPS Скан: живой список → лог → статичная таблица → атаки ──────────
# Массивы результатов скана (заполняются scan_parse)
SCAN_BSSID=(); SCAN_CH=(); SCAN_PWR=(); SCAN_WPS=(); SCAN_LCK=(); SCAN_VEN=(); SCAN_ESSID=()

# Парсер вывода wash по позиции колонки ESSID из заголовка.
# Дубли по BSSID убираются через seen[]. Все колонки сохраняются.
scan_parse() {
    local raw="$1"
    SCAN_BSSID=(); SCAN_CH=(); SCAN_PWR=(); SCAN_WPS=(); SCAN_LCK=(); SCAN_VEN=(); SCAN_ESSID=()
    local -A seen=()
    local epos=-1 line
    while IFS= read -r line; do
        # строка заголовка задаёт позицию ESSID
        if [[ $epos -lt 0 && $line == *BSSID* && $line == *ESSID* ]]; then
            epos=$(awk -v s="$line" 'BEGIN{print index(s,"ESSID")-1}')
            continue
        fi
        [ "$epos" -lt 0 ] && continue
        # только строки, начинающиеся с MAC (BSSID)
        [[ $line =~ ^[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}: ]] || continue
        local bssid ch pwr wps lck ven essid left
        bssid=$(echo "$line" | awk '{print $1}')
        [ -n "${seen[$bssid]:-}" ] && continue
        seen[$bssid]=1
        # ESSID — всё от позиции epos до конца (может содержать пробелы)
        essid="${line:$epos}"
        essid="${essid%"${essid##*[![:space:]]}"}"   # trim справа
        # левая часть до ESSID разбивается по столбцам
        left="${line:0:$epos}"
        ch=$(echo "$left"  | awk '{print $2}')
        pwr=$(echo "$left" | awk '{print $3}')
        wps=$(echo "$left" | awk '{print $4}')
        lck=$(echo "$left" | awk '{print $5}')
        # Vendor — 6-е поле, если есть
        ven=$(echo "$left" | awk '{print $6}')
        [ -z "$essid" ] && essid="<hidden>"
        SCAN_BSSID+=("$bssid"); SCAN_CH+=("$ch"); SCAN_PWR+=("$pwr")
        SCAN_WPS+=("$wps"); SCAN_LCK+=("$lck"); SCAN_VEN+=("$ven"); SCAN_ESSID+=("$essid")
    done <<< "$raw"
}

# Сохранение лога скана: wifi_ГГГГММДД_ЧЧММ_NN.log в $DATA_DIR
scan_save_log() {
    local n="${#SCAN_BSSID[@]}"
    # уникальное имя: wifi_ГГГГММДД_ЧЧММ_<кол-во сетей>.log (без секунд)
    local fname="$DATA_DIR/wifi_$(date '+%Y%m%d_%H%M')_${n}.log"
    {
        echo "# Wi-Fi WPS scan — $(date '+%Y-%m-%d %H:%M:%S')"
        echo "# $(t scan_cnt) $n"
        echo "#"
        printf '%-18s %-3s %-5s %-4s %-4s %-10s %s\n' BSSID Ch Pwr WPS Lck Vendor ESSID
        local i
        for ((i=0; i<n; i++)); do
            printf '%-18s %-3s %-5s %-4s %-4s %-10s %s\n' \
                "${SCAN_BSSID[i]}" "${SCAN_CH[i]}" "${SCAN_PWR[i]}" \
                "${SCAN_WPS[i]}" "${SCAN_LCK[i]}" "${SCAN_VEN[i]}" "${SCAN_ESSID[i]}"
        done
    } > "$fname"
    fix_owner "$fname"
    echo "$fname"
}

# Живой скан: wash крутится, Esc → стоп + сохранение лога.
# Возвращает через глобальные SCAN_* + SCAN_LOGFILE.
SCAN_LOGFILE=""
scan_run_live() {
    local tmp; tmp=$(mktemp)
    clear
    echo -e "${CYAN}${BOLD}  $(t scan_t) — WPS${NC}"
    echo -e "${YELLOW}$(t scan_live)${NC}\n"
    # wash в фоне пишет в tmp
    stdbuf -oL wash -i "$MON" -F > "$tmp" 2>/dev/null &
    local wpid=$!
    # живой показ + ожидание Esc
    local key
    while kill -0 "$wpid" 2>/dev/null; do
        # перерисовка живого списка
        clear
        echo -e "${CYAN}${BOLD}  $(t scan_t) — WPS${NC}"
        echo -e "${YELLOW}$(t scan_live)${NC}\n"
        tail -n 20 "$tmp" 2>/dev/null
        # ждём клавишу до 1 сек; Esc → стоп
        if IFS= read -rsn1 -t 1 key; then
            if [[ $key == $'\e' ]]; then break; fi
        fi
    done
    # стоп wash
    kill "$wpid" 2>/dev/null; wait "$wpid" 2>/dev/null
    scan_parse "$(cat "$tmp")"
    rm -f "$tmp"
    if [ "${#SCAN_BSSID[@]}" -eq 0 ]; then
        SCAN_LOGFILE=""
        return
    fi
    SCAN_LOGFILE="$(scan_save_log)"
}

# Статичная таблица с курсором ↑↓/1-9, Enter → атаки, Esc → выход
