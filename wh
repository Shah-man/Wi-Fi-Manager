# ── Смена MAC ─────────────────────────────────────────────────────────
menu_mac() {
    SELECTED_IDX=0
    while true; do
        find_mon_iface >/dev/null 2>&1
        local cur_mac="-"
        [ -n "$MON" ] && cur_mac=$(cat /sys/class/net/$MON/address 2>/dev/null)
        
        local options=(
            "${CYAN}|$(L "Текущий MAC" "Current MAC") ($MON): $cur_mac"
            "${GREEN}|$(L "Случайный MAC (для $MON)" "Random MAC (for $MON)")"
            "${YELLOW}|$(L "Ввести свой MAC" "Enter custom MAC")"
            "${RED}|$(L Назад Back)"
        )
        draw_menu "$(L "Смена MAC-адреса" "MAC address change")" "${options[@]}"
        local key=$(read_key); local num="${key#num:}"
        [ "$key" = "enter" ] && num=$((SELECTED_IDX+1))
        case "$key" in
            up) ((SELECTED_IDX>0)) && ((SELECTED_IDX--)) ;;
            down) ((SELECTED_IDX<${#options[@]}-1)) && ((SELECTED_IDX++)) ;;
            none) ;;
            esc) return ;;
            enter|num:*)
                case "$num" in
                    1) : ;; # Просто инфо
                    2)
                        if [ -z "$MON" ]; then echo -e "${RED}$(L "Сначала подними монитор!" "Enable monitor first!")${NC}"; sleep 2; continue; fi
                        # Генерация случайного локального MAC
                        local rmac=$(printf '02:%02x:%02x:%02x:%02x:%02x' $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))
                        info "$(L "Меняю $MON на $rmac..." "Changing $MON to $rmac...")"
                        ip link set $MON down
                        ip link set $MON address $rmac
                        ip link set $MON up
                        info "$(L "Готово. Новый MAC:" "Done. New MAC:") $(cat /sys/class/net/$MON/address)"
                        sleep 2 ;;
                    3)
                        if [ -z "$MON" ]; then echo -e "${RED}$(L "Сначала подними монитор!" "Enable monitor first!")${NC}"; sleep 2; continue; fi
                        prompt_input "$(L "Введи новый MAC (XX:XX:XX:XX:XX:XX):" "Enter new MAC (XX:XX:XX:XX:XX:XX):")" new_mac || continue
                        ip link set $MON down
                        ip link set $MON address $new_mac
                        ip link set $MON up
                        info "$(L "Применено:" "Applied:") $new_mac"
                        sleep 2 ;;
                    4) return ;;
                esac ;;
        esac
    done
}

clean_legacy_kit() {
    local old
    for old in aircrack-ng pixiewps reaver reaver-wps-fork-t6x bully; do
        [ -d "$USER_HOME/wifi-tools/$old" ] && rm -rf "$USER_HOME/wifi-tools/$old"
    done
}

sync_sources_to_kit() {
    # Копируем свежие исходники из системы в папку пользователя (для оффлайн-бэкапа)
    local kit_src="$USER_HOME/wifi-tools/src"
    if [ -d "/opt/wifi-tools/src" ]; then
        info "$(L "Синхронизирую исходники в $kit_src ..." "Syncing sources to $kit_src ...")"
        mkdir -p "$kit_src"
        clean_legacy_kit
        for n in aircrack-ng pixiewps reaver bully; do
            if [ -d "/opt/wifi-tools/src/$n" ]; then
                rm -rf "$kit_src/$n"
                # Копируем и сразу ставим текущее время (touch), чтобы свойства показывали "сейчас"
                cp -r "/opt/wifi-tools/src/$n" "$kit_src/$n"
                find "$kit_src/$n" -exec touch {} +
            fi
        done
        info "$(L "Исходники в папке обновлены." "Sources in folder updated.")"
    fi
}

